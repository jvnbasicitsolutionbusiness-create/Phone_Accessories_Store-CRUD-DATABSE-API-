/* =========================================================
   39. UPDATE ACCOUNT STATUS
   ========================================================= */

function updateAccountStatus(data) {
  data =
    data || {};

  const user =
    resolveUser(
      data
    );

  if (!user) {
    return {
      success: false,

      code:
        "ACCOUNT_NOT_FOUND",

      message:
        "Account does not exist."
    };
  }

  const requestedStatus =
    normalizeAccountStatus(
      data.status ||
      data.accountStatus
    );

  const sheet =
    getSheet();

  /*
   * Sheet account status.
   */
  sheet
    .getRange(
      user.rowNumber,
      6
    )
    .setValue(
      requestedStatus
    );

  /*
   * VERIFIED should only be true when
   * account status is actually VERIFIED.
   */
  const verified =
    requestedStatus ===
    "VERIFIED";

  sheet
    .getRange(
      user.rowNumber,
      10
    )
    .setValue(
      verified
    );

  /*
   * FIX:
   *
   * The old implementation always called
   * markFirebaseUserVerified(), which changed
   * SUSPENDED/DISABLED/BLOCKED accounts back
   * into VERIFIED in Firebase.
   *
   * This now synchronizes the ACTUAL requested
   * status.
   */
  try {
    syncFirebaseAccountStatus(
      user,
      requestedStatus
    );
  } catch (error) {
    return {
      success: false,

      code:
        "FIREBASE_STATUS_SYNC_FAILED",

      message:
        "Account status was updated in Google Sheets but could not be synchronized with Firebase.",

      detail:
        safeString(
          error.message
        )
    };
  }

  const updatedUser =
    findUser(
      user.uid
    ) || user;

  return {
    success: true,

    code:
      "ACCOUNT_STATUS_UPDATED",

    message:
      "Account status updated successfully.",

    uid:
      updatedUser.uid,

    username:
      updatedUser.username,

    role:
      updatedUser.role,

    verified:
      verified,

    accountStatus:
      requestedStatus
  };
}


/* =========================================================
   40. FORGOT PASSWORD
   ========================================================= */

function forgotPassword(data) {
  data =
    data || {};

  const identity =
    resolveOtpIdentity(
      data
    );

  const user =
    resolveUser(
      data
    ) ||
    findUser(identity);

  /*
   * For this StockFlow school project,
   * return ACCOUNT_NOT_FOUND so the frontend
   * can clearly show the user that the account
   * does not exist.
   */
  if (!user) {
    return {
      success: false,

      code:
        "ACCOUNT_NOT_FOUND",

      message:
        "Account does not exist."
    };
  }

  if (
    user.accountStatus ===
    "DISABLED"
  ) {
    return {
      success: false,

      code:
        "ACCOUNT_DISABLED",

      message:
        "This account is disabled."
    };
  }

  if (
    user.accountStatus ===
    "SUSPENDED"
  ) {
    return {
      success: false,

      code:
        "ACCOUNT_SUSPENDED",

      message:
        "This account is suspended."
    };
  }

  if (
    user.accountStatus ===
    "BLOCKED"
  ) {
    return {
      success: false,

      code:
        "ACCOUNT_BLOCKED",

      message:
        "This account is blocked."
    };
  }

  /*
   * Only verified accounts can perform
   * password recovery.
   */
  if (!user.verified) {
    return {
      success: false,

      code:
        "REQUIRES_VERIFICATION",

      message:
        "This account is not verified. Please verify the account first."
    };
  }

  /*
   * Recovery can use email or phone.
   * Default = email.
   */
  const channel =
    normalizeChannel(
      data.channel ||
      "email"
    );

  /*
   * Independent 120-second cooldown.
   */
  if (
    isChannelOnCooldown(
      user,
      channel
    )
  ) {
    const seconds =
      cooldownSeconds(
        user,
        channel
      );

    return {
      success: false,

      code:
        "OTP_COOLDOWN",

      message:
        "Please wait " +
        seconds +
        " seconds before requesting another " +
        channel +
        " recovery code.",

      cooldownSeconds:
        seconds,

      channel:
        channel
    };
  }

  const otp =
    generateOTP();

  try {
    saveOtp(
      user,
      otp,
      channel
    );
  } catch (error) {
    return {
      success: false,

      code:
        "OTP_STORAGE_FAILED",

      message:
        "The recovery code could not be stored. Please try again.",

      detail:
        safeString(
          error.message
        )
    };
  }

  const updatedUser =
    findUser(
      user.uid
    ) || user;

  const delivery =
    sendOTPByChannel(
      updatedUser,
      otp,
      channel
    );

  if (
    DEMO_MODE
  ) {
    let message =
      "Recovery code generated by the backend.";

    if (
      delivery.delivered
    ) {
      message =
        channel === "email"
          ? "Recovery code generated and sent by email."
          : "Recovery code generated and sent by phone.";
    }

    return {
      success: true,

      code:
        "RECOVERY_OTP_READY",

      message:
        message,

      otp:
        otp,

      otpReady:
        true,

      demoMode:
        true,

      uid:
        updatedUser.uid,

      username:
        updatedUser.username,

      name:
        updatedUser.name,

      gmail:
        updatedUser.gmail,

      email:
        updatedUser.gmail,

      phone:
        updatedUser.phone,

      channel:
        channel,

      emailSent:
        delivery.emailSent,

      smsSent:
        delivery.smsSent,

      delivered:
        delivery.delivered,

      otpExpires:
        updatedUser.otpExpires
          ? new Date(
              updatedUser.otpExpires
            ).toISOString()
          : null,

      cooldownSeconds:
        OTP_COOLDOWN_MS / 1000
    };
  }

  if (
    !delivery.delivered
  ) {
    clearOtpCompletely(
      updatedUser
    );

    return {
      success: false,

      code:
        "OTP_DELIVERY_FAILED",

      message:
        channel === "email"
          ? "The recovery email could not be sent."
          : "The recovery SMS could not be sent."
    };
  }

  return {
    success: true,

    code:
      "RECOVERY_OTP_READY",

    message:
      channel === "email"
        ? "Recovery code sent by email."
        : "Recovery code sent by phone.",

    otpReady:
      true,

    demoMode:
      false,

    uid:
      updatedUser.uid,

    username:
      updatedUser.username,

    gmail:
      updatedUser.gmail,

    email:
      updatedUser.gmail,

    phone:
      updatedUser.phone,

    channel:
      channel,

    emailSent:
      delivery.emailSent,

    smsSent:
      delivery.smsSent,

    delivered:
      delivery.delivered,

    otpExpires:
      updatedUser.otpExpires
        ? new Date(
            updatedUser.otpExpires
          ).toISOString()
        : null,

    cooldownSeconds:
      OTP_COOLDOWN_MS / 1000
  };
}


/* =========================================================
   41. RECOVERY TOKEN HELPERS
   ========================================================= */

function recoveryTokenKey(uid) {
  return (
    "SF_RECOVERY_" +
    safeString(uid)
  );
}


function createRecoveryToken(
  user
) {
  const token =
    Utilities.getUuid();

  const expiresAt =
    new Date(
      new Date().getTime() +
      10 * 60 * 1000
    );

  const payload = {
    token:
      token,

    uid:
      user.uid,

    expiresAt:
      expiresAt.toISOString()
  };

  PropertiesService
    .getScriptProperties()
    .setProperty(
      recoveryTokenKey(
        user.uid
      ),
      JSON.stringify(
        payload
      )
    );

  return {
    token:
      token,

    expiresAt:
      expiresAt
  };
}


function getRecoveryToken(
  uid
) {
  const raw =
    PropertiesService
      .getScriptProperties()
      .getProperty(
        recoveryTokenKey(
          uid
        )
      );

  if (!raw) {
    return null;
  }

  try {
    return JSON.parse(
      raw
    );
  } catch (error) {
    return null;
  }
}


function clearRecoveryToken(
  uid
) {
  PropertiesService
    .getScriptProperties()
    .deleteProperty(
      recoveryTokenKey(
        uid
      )
    );

  return true;
}


/* =========================================================
   42. VERIFY RECOVERY OTP
   ========================================================= */

function verifyRecoveryOtp(data) {
  data =
    data || {};

  const identity =
    resolveOtpIdentity(
      data
    );

  const otp =
    safeString(
      data.otp ||
      data.code
    ).replace(
      /\D/g,
      ""
    );

  if (
    otp.length !== OTP_LENGTH
  ) {
    return {
      success: false,

      code:
        "INVALID_OTP_FORMAT",

      message:
        "Please enter the complete 6-digit recovery code."
    };
  }

  const user =
    resolveUser(
      data
    ) ||
    findUser(identity);

  if (!user) {
    return {
      success: false,

      code:
        "ACCOUNT_NOT_FOUND",

      message:
        "Account does not exist."
    };
  }

  if (
    !user.verified
  ) {
    return {
      success: false,

      code:
        "REQUIRES_VERIFICATION",

      message:
        "This account is not verified."
    };
  }

  if (
    isLocked(user)
  ) {
    const lockUntil =
      toDate(
        user.otpLockUntil
      );

    return {
      success: false,

      code:
        "OTP_LOCKED",

      message:
        "Too many incorrect attempts. Please wait until the temporary lock expires.",

      locked: true,

      lockUntil:
        lockUntil
          ? lockUntil.toISOString()
          : null
    };
  }

  if (
    !user.otp
  ) {
    return {
      success: false,

      code:
        "OTP_NOT_READY",

      message:
        "No recovery code is currently active. Please request a new code."
    };
  }

  if (
    isExpired(
      user.otpExpires
    )
  ) {
    clearOtpCompletely(
      user
    );

    return {
      success: false,

      code:
        "OTP_EXPIRED",

      message:
        "The recovery code has expired. Please request a new code."
    };
  }

  if (
    otp !==
    safeString(
      user.otp
    )
  ) {
    const newAttempts =
      (Number(
        user.otpAttempts
      ) || 0) + 1;

    let lockUntil = "";

    if (
      newAttempts >=
      OTP_MAX_ATTEMPTS
    ) {
      lockUntil =
        new Date(
          new Date().getTime() +
          OTP_LOCK_MS
        );
    }

    const sheet =
      getSheet();

    sheet
      .getRange(
        user.rowNumber,
        13
      )
      .setValue(
        newAttempts
      );

    if (lockUntil) {
      sheet
        .getRange(
          user.rowNumber,
          14
        )
        .setValue(
          lockUntil
        );
    }

    try {
      updateFirebaseOtpAttempts(
        user,
        newAttempts,
        lockUntil
      );
    } catch (error) {
      console.warn(
        "Firebase recovery attempt sync failed: " +
        error.message
      );
    }

    if (
      newAttempts >=
      OTP_MAX_ATTEMPTS
    ) {
      return {
        success: false,

        code:
          "OTP_LOCKED",

        message:
          "You entered the wrong recovery code 4 times. Recovery is temporarily locked for 30 minutes.",

        locked: true,

        attempts:
          newAttempts,

        lockUntil:
          lockUntil.toISOString()
      };
    }

    return {
      success: false,

      code:
        "INVALID_OTP",

      message:
        "Incorrect recovery code. Please try again.",

      attempts:
        newAttempts,

      remainingAttempts:
        OTP_MAX_ATTEMPTS -
        newAttempts
    };
  }

  /*
   * Correct recovery OTP.
   *
   * Create a server-side recovery token.
   */
  const recovery =
    createRecoveryToken(
      user
    );

  /*
   * OTP cannot be reused after successful
   * recovery verification.
   */
  clearOtpCompletely(
    user
  );

  return {
    success: true,

    code:
      "RECOVERY_VERIFIED",

    message:
      "Recovery code verified. You may now create a new password.",

    recoveryVerified:
      true,

    otpVerified:
      true,

    recoveryToken:
      recovery.token,

    recoveryTokenExpires:
      recovery.expiresAt.toISOString(),

    uid:
      user.uid,

    username:
      user.username,

    gmail:
      user.gmail,

    email:
      user.gmail,

    phone:
      user.phone,

    role:
      user.role,

    verified:
      user.verified,

    accountStatus:
      user.accountStatus
  };
}


/* =========================================================
   43. RESET PASSWORD
   ========================================================= */

function resetPassword(data) {
  data =
    data || {};

  const uid =
    safeString(
      data.uid
    );

  const identity =
    safeString(
      data.identity ||
      data.username ||
      data.email ||
      data.gmail ||
      data.phone
    );

  const newPassword =
    safeString(
      data.newPassword ||
      data.password
    );

  const confirmPassword =
    safeString(
      data.confirmPassword
    );

  const recoveryToken =
    safeString(
      data.recoveryToken ||
      data.token
    );

  if (!recoveryToken) {
    return {
      success: false,

      code:
        "RECOVERY_TOKEN_REQUIRED",

      message:
        "Recovery verification is required before changing the password."
    };
  }

  if (
    newPassword !==
    confirmPassword
  ) {
    return {
      success: false,

      code:
        "PASSWORD_MISMATCH",

      message:
        "Passwords do not match."
    };
  }

  const passwordResult =
    validatePassword(
      newPassword
    );

  if (
    !passwordResult.valid
  ) {
    return {
      success: false,

      code:
        "INVALID_PASSWORD",

      message:
        passwordResult.message
    };
  }

  let user =
    null;

  if (uid) {
    user =
      findUser(uid);
  }

  if (!user && identity) {
    user =
      findUser(identity);
  }

  if (!user) {
    return {
      success: false,

      code:
        "ACCOUNT_NOT_FOUND",

      message:
        "Account does not exist."
    };
  }

  /*
   * Validate server-side recovery token.
   */
  const stored =
    getRecoveryToken(
      user.uid
    );

  if (!stored) {
    return {
      success: false,

      code:
        "RECOVERY_SESSION_EXPIRED",

      message:
        "Your password recovery session has expired. Please request a new recovery code."
    };
  }

  if (
    stored.token !==
    recoveryToken
  ) {
    return {
      success: false,

      code:
        "INVALID_RECOVERY_TOKEN",

      message:
        "Invalid password recovery session."
    };
  }

  if (
    !stored.expiresAt ||
    isExpired(
      stored.expiresAt
    )
  ) {
    clearRecoveryToken(
      user.uid
    );

    return {
      success: false,

      code:
        "RECOVERY_SESSION_EXPIRED",

      message:
        "Your password recovery session has expired. Please request a new recovery code."
    };
  }

  /*
   * Update password in Google Sheet.
   *
   * Existing project structure stores the
   * password in the USER sheet, so this keeps
   * compatibility with the current system.
   */
  const sheet =
    getSheet();

  sheet
    .getRange(
      user.rowNumber,
      4
    )
    .setValue(
      newPassword
    );

  /*
   * IMPORTANT:
   * Password reset does NOT automatically
   * change verification/account status.
   */
  clearRecoveryToken(
    user.uid
  );

  clearOtpCompletely(
    user
  );

  /*
   * Sync Firebase user password for compatibility
   * with the current project structure.
   */
  try {
    firebaseRequest(
      "users/" +
      encodeURIComponent(
        user.uid
      ),
      "patch",
      {
        password:
          newPassword,

        updatedAt:
          new Date().toISOString()
      }
    );
  } catch (error) {
    return {
      success: false,

      code:
        "FIREBASE_PASSWORD_SYNC_FAILED",

      message:
        "Password was updated locally but could not be synchronized with Firebase.",

      detail:
        safeString(
          error.message
        )
    };
  }

  return {
    success: true,

    code:
      "PASSWORD_RESET_SUCCESS",

    message:
      "Password reset successfully.",

    uid:
      user.uid,

    username:
      user.username,

    gmail:
      user.gmail,

    email:
      user.gmail,

    phone:
      user.phone,

    role:
      user.role,

    verified:
      user.verified,

    accountStatus:
      user.accountStatus,

    redirect:
      "auth.html"
  };
}


/* =========================================================
   44. REQUEST BODY PARSER
   ========================================================= */

function parseRequestBody(e) {
  if (
    !e ||
    !e.postData
  ) {
    return {};
  }

  const raw =
    safeString(
      e.postData.contents
    );

  if (!raw) {
    return {};
  }

  try {
    return JSON.parse(
      raw
    );
  } catch (error) {
    /*
     * Support form-style requests as a
     * compatibility fallback.
     */
    return e.parameter || {};
  }
}


/* =========================================================
   45. JSON RESPONSE
   ========================================================= */

function jsonResponse(data) {
  return ContentService
    .createTextOutput(
      JSON.stringify(
        data
      )
    )
    .setMimeType(
      ContentService
        .MimeType
        .JSON
    );
}


/* =========================================================
   46. doPost
   ========================================================= */

function doPost(e) {
  try {
    const data =
      parseRequestBody(
        e
      );

    const action =
      safeString(
        data.action ||
        data.endpoint ||
        data.operation
      ).toLowerCase();

    switch (action) {

      /* -----------------------------------------
         AUTHENTICATION
         ----------------------------------------- */

      case "register":
      case "registeruser":
        return jsonResponse(
          registerUser(
            data
          )
        );


      case "registeradmin":
      case "register_admin":
        return jsonResponse(
          registerAdmin(
            data
          )
        );


      case "login":
      case "loginuser":
        return jsonResponse(
          loginUser(
            data
          )
        );


      case "getuser":
      case "user":
        return jsonResponse(
          getUser(
            data
          )
        );


      /* -----------------------------------------
         REGISTRATION OTP
         ----------------------------------------- */

      case "prepareotp":
      case "prepare_otp":
        return jsonResponse(
          prepareOtp(
            data
          )
        );


      case "generateotp":
      case "generate_otp":
        return jsonResponse(
          generateOtp(
            data
          )
        );


      case "resendotp":
      case "resend_otp":
        return jsonResponse(
          resendOTP(
            data
          )
        );


      case "requestotp":
      case "request_otp":
        return jsonResponse(
          requestOtp(
            data
          )
        );


      case "verifyotp":
      case "verify_otp":
        return jsonResponse(
          verifyOTP(
            data
          )
        );


      /* -----------------------------------------
         PASSWORD RECOVERY
         ----------------------------------------- */

      case "forgotpassword":
      case "forgot_password":
        return jsonResponse(
          forgotPassword(
            data
          )
        );


      case "verifyrecoveryotp":
      case "verify_recovery_otp":
        return jsonResponse(
          verifyRecoveryOtp(
            data
          )
        );


      case "resetpassword":
      case "reset_password":
        return jsonResponse(
          resetPassword(
            data
          )
        );


      /* -----------------------------------------
         ACCOUNT MANAGEMENT
         ----------------------------------------- */

      case "updatestatus":
      case "update_status":
      case "updateaccountstatus":
      case "update_account_status":
        return jsonResponse(
          updateAccountStatus(
            data
          )
        );


      /* -----------------------------------------
         UNKNOWN ACTION
         ----------------------------------------- */

      default:
        return jsonResponse({
          success: false,

          code:
            "UNKNOWN_ACTION",

          message:
            "Unknown API action: " +
            (
              action ||
              "(empty)"
            )
        });
    }

  } catch (error) {

    console.error(
      "doPost error:",
      error
    );

    return jsonResponse({
      success: false,

      code:
        "SERVER_ERROR",

      message:
        "The server encountered an unexpected error.",

      detail:
        DEMO_MODE
          ? safeString(
              error.message
            )
          : undefined
    });
  }
}


/* =========================================================
   47. doGet
   ========================================================= */

function doGet() {
  return jsonResponse({
    success: true,

    code:
      "ONLINE",

    status:
      "ONLINE",

    message:
      APP_NAME +
      " API is online.",

    app:
      APP_NAME,

    demoMode:
      DEMO_MODE,

    sheet:
      SHEET_NAME,

    otp: {
      length:
        OTP_LENGTH,

      expirationMinutes:
        OTP_EXPIRATION_MS /
        60000,

      maxAttempts:
        OTP_MAX_ATTEMPTS,

      lockMinutes:
        OTP_LOCK_MS /
        60000,

      resendCooldownSeconds:
        OTP_COOLDOWN_MS /
        1000
    },

    endpoints: [
      "register",
      "registerAdmin",
      "login",
      "getUser",
      "prepareOtp",
      "generateOtp",
      "resendOtp",
      "requestOtp",
      "verifyOtp",
      "forgotPassword",
      "verifyRecoveryOtp",
      "resetPassword",
      "updateStatus"
    ]
  });
}


