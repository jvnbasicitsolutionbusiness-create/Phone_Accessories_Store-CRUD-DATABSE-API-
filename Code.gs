/* =========================================================
   STOCKFLOW - GOOGLE APPS SCRIPT BACKEND
   =========================================================
   System:
   StockFlow | Phone Accessories Inventory Management System

   Storage:
   - Google Sheets
   - Firebase Realtime Database

   Authentication:
   - Username / Gmail / Phone
   - Server-generated OTP
   - Email / Phone OTP
   - 4 failed OTP attempts
   - 30-minute OTP lock
   - 120-second independent resend cooldown

   IMPORTANT:
   - OTP is NEVER generated by frontend JavaScript.
   - OTP is generated here on the Apps Script server.
   - DEMO_MODE returns the real server-generated OTP to the frontend
     so the school-project demo can automatically fill the OTP boxes.
   ========================================================= */


/* =========================================================
   1. CONFIGURATION
   ========================================================= */

const SHEET_ID =
  "1w3j0sV9rDiBvS4cpHU31iGb4KIeyUPoALZf5vLH2ivY";

const SHEET_NAME = "USER";

const APP_NAME = "StockFlow";

const FIREBASE_URL =
  "https://midtermexamproject-default-rtdb.firebaseio.com/";

/*
 * SCHOOL PROJECT DEMO MODE
 *
 * true:
 * - Returns the actual backend-generated OTP to frontend.
 * - Allows OTP verification even if MailApp/Twilio is not configured.
 * - Does NOT create fake OTPs.
 *
 * false:
 * - OTP should be delivered through the configured provider.
 */
const DEMO_MODE = true;


/* =========================================================
   OTP SETTINGS
   ========================================================= */

const OTP_LENGTH = 6;

const OTP_EXPIRATION_MS =
  10 * 60 * 1000; // 10 minutes

const OTP_MAX_ATTEMPTS = 4;

const OTP_LOCK_MS =
  30 * 60 * 1000; // 30 minutes

const OTP_COOLDOWN_MS =
  120 * 1000; // 2 minutes


/* =========================================================
   PASSWORD SETTINGS
   ========================================================= */

const PASSWORD_MIN_LENGTH = 8;


/* =========================================================
   USER SHEET HEADERS
   ========================================================= */

const HEADERS = [
  "UID",
  "NAME",
  "USERNAME",
  "PASSWORD",
  "AGE",
  "ACCOUNT_S",
  "GMAIL",
  "PHONE NO.",
  "ROLE",
  "VERIFIED",
  "OTP",
  "OTP EXPIRES",
  "OTP ATTEMPTS",
  "OTP LOCK UNTIL",
  "OTP CHANNEL",
  "CREATED AT",
  "VERIFIED AT",
  "LAST OTP SENT",
  "LAST LOGIN",
  "LAST EMAIL OTP SENT",
  "LAST PHONE OTP SENT"
];


/* =========================================================
   2. GOOGLE SHEET HELPERS
   ========================================================= */

function getSheet() {
  const spreadsheet =
    SpreadsheetApp.openById(SHEET_ID);

  let sheet =
    spreadsheet.getSheetByName(SHEET_NAME);

  if (!sheet) {
    sheet =
      spreadsheet.insertSheet(SHEET_NAME);
  }

  ensureHeaders(sheet);

  return sheet;
}


function ensureHeaders(sheet) {
  const requiredColumns = HEADERS.length;

  if (sheet.getMaxColumns() < requiredColumns) {
    sheet.insertColumnsAfter(
      sheet.getMaxColumns(),
      requiredColumns - sheet.getMaxColumns()
    );
  }

  const currentHeaders =
    sheet
      .getRange(1, 1, 1, requiredColumns)
      .getValues()[0];

  let needsUpdate = false;

  for (let i = 0; i < HEADERS.length; i++) {
    if (currentHeaders[i] !== HEADERS[i]) {
      needsUpdate = true;
      break;
    }
  }

  if (needsUpdate) {
    sheet
      .getRange(1, 1, 1, HEADERS.length)
      .setValues([HEADERS]);
  }
}


function getRows() {
  const sheet = getSheet();

  const lastRow =
    sheet.getLastRow();

  if (lastRow < 2) {
    return [];
  }

  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        HEADERS.length
      )
      .getValues();

  return values.map(function(row, index) {
    return {
      rowNumber: index + 2,
      values: row
    };
  });
}


/* =========================================================
   3. NORMALIZATION HELPERS
   ========================================================= */

function safeString(value) {
  if (value === null || value === undefined) {
    return "";
  }

  return String(value).trim();
}


function normalizeUsername(value) {
  return safeString(value).toLowerCase();
}


function normalizeEmail(value) {
  return safeString(value).toLowerCase();
}


function normalizePhone(value) {
  let phone =
    safeString(value).replace(/\s+/g, "");

  /*
   * Convert:
   * +639XXXXXXXXX
   * 639XXXXXXXXX
   * 09XXXXXXXXX
   * into:
   * 09XXXXXXXXX
   */

  if (phone.indexOf("+63") === 0) {
    phone =
      "0" + phone.substring(3);
  } else if (phone.indexOf("63") === 0 &&
             phone.length === 12) {
    phone =
      "0" + phone.substring(2);
  }

  return phone;
}


function normalizeIdentity(value) {
  const identity =
    safeString(value);

  if (!identity) {
    return "";
  }

  if (
    identity.indexOf("@") !== -1
  ) {
    return normalizeEmail(identity);
  }

  if (
    /^(\+63|63|09)\d+$/.test(identity)
  ) {
    return normalizePhone(identity);
  }

  return normalizeUsername(identity);
}


function normalizeChannel(value) {
  const channel =
    safeString(value).toLowerCase();

  if (
    channel === "phone" ||
    channel === "sms" ||
    channel === "mobile"
  ) {
    return "phone";
  }

  return "email";
}


function normalizeRole(value) {
  const role =
    safeString(value).toLowerCase();

  if (role === "admin") {
    return "Admin";
  }

  if (role === "manager") {
    return "Manager";
  }

  return "Employee";
}


function normalizeAccountStatus(value) {
  const status =
    safeString(value).toUpperCase();

  const allowed = [
    "PENDING",
    "VERIFIED",
    "SUSPENDED",
    "DISABLED",
    "BLOCKED"
  ];

  if (allowed.indexOf(status) !== -1) {
    return status;
  }

  return "PENDING";
}


function normalizeBoolean(value) {
  if (
    value === true ||
    value === "true" ||
    value === "TRUE" ||
    value === 1 ||
    value === "1"
  ) {
    return true;
  }

  return false;
}


/* =========================================================
   4. UID
   ========================================================= */

function generateUID() {
  const timestamp =
    new Date().getTime();

  const randomPart =
    Math.floor(
      Math.random() * 1000000
    )
      .toString()
      .padStart(6, "0");

  return (
    "SF-" +
    timestamp +
    "-" +
    randomPart
  );
}


/* =========================================================
   5. SERVER OTP GENERATION
   ========================================================= */

function generateOTP() {
  let otp = "";

  for (let i = 0; i < OTP_LENGTH; i++) {
    otp += Math.floor(
      Math.random() * 10
    );
  }

  return otp;
}


/* =========================================================
   6. PASSWORD VALIDATION
   ========================================================= */

function validatePassword(password) {
  const value =
    safeString(password);

  if (
    value.length <
    PASSWORD_MIN_LENGTH
  ) {
    return {
      valid: false,
      message:
        "Password must be at least 8 characters."
    };
  }

  if (!/[A-Z]/.test(value)) {
    return {
      valid: false,
      message:
        "Password must contain at least one uppercase letter."
    };
  }

  if (!/[a-z]/.test(value)) {
    return {
      valid: false,
      message:
        "Password must contain at least one lowercase letter."
    };
  }

  if (!/[0-9]/.test(value)) {
    return {
      valid: false,
      message:
        "Password must contain at least one number."
    };
  }

  if (!/[^A-Za-z0-9]/.test(value)) {
    return {
      valid: false,
      message:
        "Password must contain at least one special character."
    };
  }

  return {
    valid: true,
    message: ""
  };
}


/* =========================================================
   7. USER OBJECT
   ========================================================= */

function rowToUser(rowObject) {
  if (!rowObject) {
    return null;
  }

  const row =
    rowObject.values;

  const verified =
    normalizeBoolean(row[9]);

  const accountStatus =
    normalizeAccountStatus(row[5]);

  return {
    rowNumber: rowObject.rowNumber,

    uid: safeString(row[0]),

    name: safeString(row[1]),

    username: safeString(row[2]),

    password: safeString(row[3]),

    age: row[4],

    accountStatus: accountStatus,

    gmail: normalizeEmail(row[6]),

    email: normalizeEmail(row[6]),

    phone: normalizePhone(row[7]),

    role: normalizeRole(row[8]),

    verified: verified,

    otp: safeString(row[10]),

    otpExpires: row[11],

    otpAttempts:
      Number(row[12]) || 0,

    otpLockUntil: row[13],

    otpChannel:
      safeString(row[14]),

    createdAt: row[15],

    verifiedAt: row[16],

    lastOtpSent: row[17],

    lastLogin: row[18],

    lastEmailOtpSent: row[19],

    lastPhoneOtpSent: row[20]
  };
}


/* =========================================================
   8. FIND USER
   ========================================================= */

function findUser(identifier) {
  const normalized =
    normalizeIdentity(identifier);

  if (!normalized) {
    return null;
  }

  const rows =
    getRows();

  for (let i = 0; i < rows.length; i++) {
    const user =
      rowToUser(rows[i]);

    if (!user) {
      continue;
    }

    if (
      safeString(user.uid)
        .toLowerCase() === normalized ||

      normalizeUsername(user.username) === normalized ||

      normalizeEmail(user.gmail) === normalized ||

      normalizePhone(user.phone) === normalized
    ) {
      return user;
    }
  }

  return null;
}


/* =========================================================
   9. FIND USER BY MULTIPLE POSSIBLE IDENTITIES
   ========================================================= */

function resolveUser(data) {
  data =
    data || {};

  const candidates = [
    data.uid,
    data.identity,
    data.username,
    data.gmail,
    data.email,
    data.phone
  ];

  for (let i = 0; i < candidates.length; i++) {
    const value =
      safeString(candidates[i]);

    if (!value) {
      continue;
    }

    const user =
      findUser(value);

    if (user) {
      return user;
    }
  }

  return null;
}


/* =========================================================
   10. REGISTRATION VALIDATION
   ========================================================= */

function validateRegistrationData(data) {
  data =
    data || {};

  const firstName =
    safeString(
      data.firstName ||
      data.firstname
    );

  const lastName =
    safeString(
      data.lastName ||
      data.lastname
    );

  const name =
    safeString(
      data.name ||
      (
        firstName +
        " " +
        lastName
      )
    );

  const username =
    normalizeUsername(
      data.username
    );

  const age =
    Number(data.age);

  const gmail =
    normalizeEmail(
      data.gmail ||
      data.email
    );

  const phone =
    normalizePhone(
      data.phone ||
      data.phoneNumber
    );

  const password =
    safeString(
      data.password
    );

  if (!name) {
    return {
      valid: false,
      code: "NAME_REQUIRED",
      message:
        "Full name is required."
    };
  }

  if (
    !username ||
    username.length < 4 ||
    username.length > 30
  ) {
    return {
      valid: false,
      code: "INVALID_USERNAME",
      message:
        "Username must be 4 to 30 characters."
    };
  }

  if (
    !/^[a-z0-9._-]+$/.test(username)
  ) {
    return {
      valid: false,
      code: "INVALID_USERNAME",
      message:
        "Username may contain letters, numbers, dots, underscores, and hyphens only."
    };
  }

  if (
    !Number.isFinite(age) ||
    age < 18 ||
    age > 100
  ) {
    return {
      valid: false,
      code: "INVALID_AGE",
      message:
        "Age must be between 18 and 100."
    };
  }

  if (
    !gmail ||
    !/^[a-zA-Z0-9._%+-]+@gmail\.com$/i.test(gmail)
  ) {
    return {
      valid: false,
      code: "INVALID_GMAIL",
      message:
        "Please enter a valid Gmail address."
    };
  }

  if (
    !/^09\d{9}$/.test(phone)
  ) {
    return {
      valid: false,
      code: "INVALID_PHONE",
      message:
        "Please enter a valid Philippine mobile number."
    };
  }

  const passwordResult =
    validatePassword(password);

  if (!passwordResult.valid) {
    return {
      valid: false,
      code: "INVALID_PASSWORD",
      message:
        passwordResult.message
    };
  }

  if (
    safeString(data.confirmPassword) &&
    password !==
    safeString(data.confirmPassword)
  ) {
    return {
      valid: false,
      code: "PASSWORD_MISMATCH",
      message:
        "Passwords do not match."
    };
  }

  return {
    valid: true,
    code: "VALID",
    message: "",

    name: name,
    username: username,
    age: age,
    gmail: gmail,
    phone: phone,
    password: password
  };
}


/* =========================================================
   11. DUPLICATE ACCOUNT CHECK
   ========================================================= */

function checkDuplicateUser(
  username,
  gmail,
  phone
) {
  const rows =
    getRows();

  const normalizedUsername =
    normalizeUsername(username);

  const normalizedGmail =
    normalizeEmail(gmail);

  const normalizedPhone =
    normalizePhone(phone);

  for (let i = 0; i < rows.length; i++) {
    const user =
      rowToUser(rows[i]);

    if (
      normalizeUsername(user.username) ===
      normalizedUsername
    ) {
      return {
        duplicate: true,
        code: "USERNAME_EXISTS",
        message:
          "Username already exists."
      };
    }

    if (
      normalizeEmail(user.gmail) ===
      normalizedGmail
    ) {
      return {
        duplicate: true,
        code: "EMAIL_EXISTS",
        message:
          "Gmail address is already registered."
      };
    }

    if (
      normalizePhone(user.phone) ===
      normalizedPhone
    ) {
      return {
        duplicate: true,
        code: "PHONE_EXISTS",
        message:
          "Phone number is already registered."
      };
    }
  }

  return {
    duplicate: false
  };
}


/* =========================================================
   12. FIREBASE HELPERS
   ========================================================= */

function firebaseBaseUrl() {
  return FIREBASE_URL.replace(/\/+$/, "");
}


function firebaseRequest(
  path,
  method,
  payload
) {
  const url =
    firebaseBaseUrl() +
    "/" +
    path.replace(/^\/+/, "") +
    ".json";

  const options = {
    method:
      method || "get",

    muteHttpExceptions: true,

    contentType:
      "application/json"
  };

  if (
    payload !== undefined
  ) {
    options.payload =
      JSON.stringify(payload);
  }

  const response =
    UrlFetchApp.fetch(
      url,
      options
    );

  const status =
    response.getResponseCode();

  const text =
    response.getContentText();

  if (
    status < 200 ||
    status >= 300
  ) {
    throw new Error(
      "Firebase HTTP " +
      status +
      ": " +
      text
    );
  }

  if (!text) {
    return null;
  }

  try {
    return JSON.parse(text);
  } catch (error) {
    return text;
  }
}


/* =========================================================
   13. FIREBASE USER SAVE
   ========================================================= */

function saveFirebaseUser(user) {
  if (!user || !user.uid) {
    return false;
  }

  const path =
    "users/" +
    encodeURIComponent(
      user.uid
    );

  const payload = {
    uid: user.uid,

    name: user.name,

    username: user.username,

    age: user.age,

    accountStatus:
      normalizeAccountStatus(
        user.accountStatus
      ),

    gmail: user.gmail,

    email: user.gmail,

    phone: user.phone,

    role: user.role,

    verified:
      normalizeBoolean(
        user.verified
      ),

    createdAt:
      user.createdAt ||
      new Date().toISOString()
  };

  /*
   * Kept for compatibility with the
   * current school-project structure.
   */
  if (user.password) {
    payload.password =
      user.password;
  }

  firebaseRequest(
    path,
    "put",
    payload
  );

  return true;
}


/* =========================================================
   14. FIREBASE OTP SAVE
   ========================================================= */

function saveOtpToFirebase(
  user,
  otp,
  channel,
  expiresAt
) {
  if (!user || !user.uid) {
    return false;
  }

  const path =
    "users/" +
    encodeURIComponent(
      user.uid
    ) +
    "/otp";

  const payload = {
    code: otp,

    channel: channel,

    expiresAt:
      expiresAt.toISOString(),

    attempts: 0,

    lockUntil: "",

    updatedAt:
      new Date().toISOString()
  };

  firebaseRequest(
    path,
    "put",
    payload
  );

  return true;
}


/* =========================================================
   15. FIREBASE OTP ATTEMPTS
   ========================================================= */

function updateFirebaseOtpAttempts(
  user,
  attempts,
  lockUntil
) {
  if (!user || !user.uid) {
    return false;
  }

  const path =
    "users/" +
    encodeURIComponent(
      user.uid
    ) +
    "/otp";

  const payload = {
    attempts:
      Number(attempts) || 0,

    lockUntil:
      lockUntil
        ? new Date(lockUntil).toISOString()
        : "",

    updatedAt:
      new Date().toISOString()
  };

  firebaseRequest(
    path,
    "patch",
    payload
  );

  return true;
}


/* =========================================================
   16. CLEAR FIREBASE OTP
   ========================================================= */

function clearOtpFromFirebase(user) {
  if (!user || !user.uid) {
    return false;
  }

  const path =
    "users/" +
    encodeURIComponent(
      user.uid
    ) +
    "/otp";

  firebaseRequest(
    path,
    "delete"
  );

  return true;
}


function clearFirebaseOtpFields(user) {
  return clearOtpFromFirebase(user);
}


/* =========================================================
   17. FIREBASE ACCOUNT STATUS SYNC
   ========================================================= */

function syncFirebaseAccountStatus(
  user,
  status
) {
  if (!user || !user.uid) {
    return false;
  }

  const normalizedStatus =
    normalizeAccountStatus(
      status
    );

  const verified =
    normalizedStatus === "VERIFIED";

  const path =
    "users/" +
    encodeURIComponent(
      user.uid
    );

  const payload = {
    accountStatus:
      normalizedStatus,

    verified:
      verified,

    updatedAt:
      new Date().toISOString()
  };

  firebaseRequest(
    path,
    "patch",
    payload
  );

  return true;
}


/* =========================================================
   18. FIREBASE VERIFIED MARKER
   ========================================================= */

function markFirebaseUserVerified(user) {
  return syncFirebaseAccountStatus(
    user,
    "VERIFIED"
  );
}


/* =========================================================
   19. EMAIL
   ========================================================= */

function sendOtpEmail(
  user,
  otp
) {
  const email =
    normalizeEmail(
      user.gmail ||
      user.email
    );

  if (!email) {
    return {
      sent: false,
      error:
        "No Gmail address is registered."
    };
  }

  const subject =
    APP_NAME +
    " - Verification Code";

  const body =
    "Hello " +
    safeString(user.name) +
    ",\n\n" +

    "Your " +
    APP_NAME +
    " verification code is:\n\n" +

    otp +
    "\n\n" +

    "This code will expire in 10 minutes.\n\n" +

    "If you did not request this code, please ignore this message.\n\n" +

    "Regards,\n" +
    APP_NAME;

  try {
    MailApp.sendEmail({
      to: email,
      subject: subject,
      body: body
    });

    return {
      sent: true,
      error: ""
    };

  } catch (error) {
    return {
      sent: false,
      error:
        safeString(
          error.message
        )
    };
  }
}


/* =========================================================
   20. TWILIO SMS
   ========================================================= */

function getTwilioSettings() {
  const properties =
    PropertiesService
      .getScriptProperties();

  return {
    accountSid:
      safeString(
        properties.getProperty(
          "TWILIO_ACCOUNT_SID"
        )
      ),

    authToken:
      safeString(
        properties.getProperty(
          "TWILIO_AUTH_TOKEN"
        )
      ),

    from:
      safeString(
        properties.getProperty(
          "TWILIO_PHONE_NUMBER"
        )
      )
  };
}


function sendOtpSms(
  user,
  otp
) {
  const settings =
    getTwilioSettings();

  if (
    !settings.accountSid ||
    !settings.authToken ||
    !settings.from
  ) {
    return {
      sent: false,
      error:
        "Twilio is not configured."
    };
  }

  const phone =
    normalizePhone(
      user.phone
    );

  if (!phone) {
    return {
      sent: false,
      error:
        "No phone number is registered."
    };
  }

  const internationalPhone =
    "+63" +
    phone.substring(1);

  const url =
    "https://api.twilio.com/2010-04-01/Accounts/" +
    settings.accountSid +
    "/Messages.json";

  const message =
    APP_NAME +
    " verification code: " +
    otp +
    ". Expires in 10 minutes.";

  const options = {
    method: "post",

    muteHttpExceptions: true,

    payload: {
      To: internationalPhone,
      From: settings.from,
      Body: message
    },

    headers: {
      Authorization:
        "Basic " +
        Utilities.base64Encode(
          settings.accountSid +
          ":" +
          settings.authToken
        )
    }
  };

  try {
    const response =
      UrlFetchApp.fetch(
        url,
        options
      );

    const status =
      response.getResponseCode();

    if (
      status >= 200 &&
      status < 300
    ) {
      return {
        sent: true,
        error: ""
      };
    }

    return {
      sent: false,
      error:
        response.getContentText()
    };

  } catch (error) {
    return {
      sent: false,
      error:
        safeString(
          error.message
        )
    };
  }
}


/* =========================================================
   21. SEND OTP BY CHANNEL
   ========================================================= */

function sendOTPByChannel(
  user,
  otp,
  channel
) {
  const selectedChannel =
    normalizeChannel(
      channel
    );

  let emailSent = false;
  let smsSent = false;

  let emailError = "";
  let smsError = "";

  if (
    selectedChannel === "email"
  ) {
    const emailResult =
      sendOtpEmail(
        user,
        otp
      );

    emailSent =
      emailResult.sent;

    emailError =
      emailResult.error;

  } else if (
    selectedChannel === "phone"
  ) {
    const smsResult =
      sendOtpSms(
        user,
        otp
      );

    smsSent =
      smsResult.sent;

    smsError =
      smsResult.error;
  }

  const delivered =
    emailSent ||
    smsSent;

  return {
    channel:
      selectedChannel,

    emailSent:
      emailSent,

    smsSent:
      smsSent,

    delivered:
      delivered,

    emailError:
      emailError,

    smsError:
      smsError
  };
}


/* =========================================================
   22. DATE HELPERS
   ========================================================= */

function toDate(value) {
  if (!value) {
    return null;
  }

  if (
    Object.prototype.toString.call(value) ===
    "[object Date]"
  ) {
    return isNaN(value.getTime())
      ? null
      : value;
  }

  const date =
    new Date(value);

  if (
    isNaN(date.getTime())
  ) {
    return null;
  }

  return date;
}


function isExpired(dateValue) {
  const date =
    toDate(dateValue);

  if (!date) {
    return true;
  }

  return (
    new Date().getTime() >=
    date.getTime()
  );
}


function isLocked(user) {
  if (!user) {
    return false;
  }

  const lockUntil =
    toDate(
      user.otpLockUntil
    );

  if (!lockUntil) {
    return false;
  }

  return (
    new Date().getTime() <
    lockUntil.getTime()
  );
}


/* =========================================================
   23. INDEPENDENT CHANNEL COOLDOWN
   ========================================================= */

function getChannelLastSent(
  user,
  channel
) {
  const selectedChannel =
    normalizeChannel(
      channel
    );

  if (
    selectedChannel === "phone"
  ) {
    return toDate(
      user.lastPhoneOtpSent
    );
  }

  return toDate(
    user.lastEmailOtpSent
  );
}


function getChannelCooldownRemaining(
  user,
  channel
) {
  const lastSent =
    getChannelLastSent(
      user,
      channel
    );

  if (!lastSent) {
    return 0;
  }

  const elapsed =
    new Date().getTime() -
    lastSent.getTime();

  const remaining =
    OTP_COOLDOWN_MS -
    elapsed;

  return Math.max(
    0,
    remaining
  );
}


function isChannelOnCooldown(
  user,
  channel
) {
  return (
    getChannelCooldownRemaining(
      user,
      channel
    ) > 0
  );
}


function cooldownSeconds(
  user,
  channel
) {
  return Math.ceil(
    getChannelCooldownRemaining(
      user,
      channel
    ) / 1000
  );
}


/* =========================================================
   24. SHEET OTP SAVE
   ========================================================= */

function saveOtp(
  user,
  otp,
  channel
) {
  const sheet =
    getSheet();

  const expiresAt =
    new Date(
      new Date().getTime() +
      OTP_EXPIRATION_MS
    );

  const now =
    new Date();

  const row =
    user.rowNumber;

  const previous =
    sheet
      .getRange(
        row,
        11,
        1,
        11
      )
      .getValues()[0];

  /*
   * Columns:
   * 11 OTP
   * 12 OTP EXPIRES
   * 13 OTP ATTEMPTS
   * 14 OTP LOCK UNTIL
   * 15 OTP CHANNEL
   * 16 CREATED AT
   * 17 VERIFIED AT
   * 18 LAST OTP SENT
   * 19 LAST LOGIN
   * 20 LAST EMAIL OTP SENT
   * 21 LAST PHONE OTP SENT
   */

  const values = [
    otp,
    expiresAt,
    0,
    "",
    normalizeChannel(channel),
    previous[5],
    previous[6],
    now,
    previous[8],
    previous[9],
    previous[10]
  ];

  if (
    normalizeChannel(channel) ===
    "email"
  ) {
    values[9] = now;
  } else {
    values[10] = now;
  }

  sheet
    .getRange(
      row,
      11,
      1,
      11
    )
    .setValues([
      values
    ]);

  try {
    saveOtpToFirebase(
      user,
      otp,
      normalizeChannel(channel),
      expiresAt
    );

    return {
      success: true,
      expiresAt: expiresAt
    };

  } catch (error) {

    /*
     * Roll back Sheet OTP if Firebase
     * cannot store the OTP.
     */
    sheet
      .getRange(
        row,
        11,
        1,
        11
      )
      .setValues([
        previous
      ]);

    throw error;
  }
}


/* =========================================================
   25. CLEAR SHEET OTP
   ========================================================= */

function clearSheetOtp(user) {
  if (!user) {
    return false;
  }

  const sheet =
    getSheet();

  const row =
    user.rowNumber;

  sheet
    .getRange(
      row,
      11,
      1,
      5
    )
    .clearContent();

  return true;
}


/* =========================================================
   26. CLEAR OTP COMPLETELY
   ========================================================= */

function clearOtpCompletely(user) {
  if (!user) {
    return false;
  }

  clearSheetOtp(user);

  try {
    clearOtpFromFirebase(user);
  } catch (error) {
    console.warn(
      "Firebase OTP cleanup failed: " +
      error.message
    );
  }

  return true;
}


/* =========================================================
   27. OTP RESPONSE
   ========================================================= */

function otpResponse(
  user,
  otp,
  channel,
  delivery,
  message
) {
  const selectedChannel =
    normalizeChannel(
      channel
    );

  const expiresAt =
    toDate(
      user.otpExpires
    );

  return {
    success: true,

    code: "OTP_READY",

    message:
      message ||
      "Verification code is ready.",

    otp:
      DEMO_MODE
        ? otp
        : undefined,

    otpReady: true,

    otpExpires:
      expiresAt
        ? expiresAt.toISOString()
        : null,

    channel:
      selectedChannel,

    uid:
      user.uid,

    username:
      user.username,

    name:
      user.name,

    gmail:
      user.gmail,

    email:
      user.gmail,

    phone:
      user.phone,

    role:
      user.role,

    accountStatus:
      user.accountStatus,

    verified:
      user.verified,

    emailSent:
      delivery
        ? delivery.emailSent
        : false,

    smsSent:
      delivery
        ? delivery.smsSent
        : false,

    delivered:
      delivery
        ? delivery.delivered
        : false,

    emailDelivery:
      delivery
        ? delivery.emailSent
        : false,

    phoneDelivery:
      delivery
        ? delivery.smsSent
        : false,

    cooldownSeconds:
      OTP_COOLDOWN_MS / 1000,

    demoMode:
      DEMO_MODE
  };
}


/* =========================================================
   28. REGISTER USER
   ========================================================= */

function registerUser(data) {
  data =
    data || {};

  const validation =
    validateRegistrationData(
      data
    );

  if (!validation.valid) {
    return {
      success: false,

      code:
        validation.code,

      message:
        validation.message
    };
  }

  const duplicate =
    checkDuplicateUser(
      validation.username,
      validation.gmail,
      validation.phone
    );

  if (duplicate.duplicate) {
    return {
      success: false,

      code:
        duplicate.code,

      message:
        duplicate.message
    };
  }

  const now =
    new Date();

  const uid =
    generateUID();

  const role =
    "Employee";

  const accountStatus =
    "PENDING";

  const verified =
    false;

  const sheet =
    getSheet();

  const row = [
    uid,

    validation.name,

    validation.username,

    validation.password,

    validation.age,

    accountStatus,

    validation.gmail,

    validation.phone,

    role,

    verified,

    "",
    "",
    0,
    "",
    "",

    now,
    "",

    "",
    "",
    "",
    ""
  ];

  sheet
    .appendRow(row);

  const newUser =
    findUser(uid);

  if (!newUser) {
    return {
      success: false,

      code:
        "REGISTRATION_SAVE_FAILED",

      message:
        "The account was created but could not be loaded. Please try again."
    };
  }

  try {
    saveFirebaseUser(
      newUser
    );
  } catch (error) {

    /*
     * If Firebase fails, remove the
     * newly-created Sheet row.
     */
    sheet.deleteRow(
      newUser.rowNumber
    );

    return {
      success: false,

      code:
        "FIREBASE_SAVE_FAILED",

      message:
        "The account could not be synchronized with the database. Please try again."
    };
  }

  return {
    success: true,

    code:
      "REGISTRATION_SUCCESS",

    message:
      "Registration successful. Please verify your account.",

    uid:
      newUser.uid,

    username:
      newUser.username,

    name:
      newUser.name,

    gmail:
      newUser.gmail,

    email:
      newUser.gmail,

    phone:
      newUser.phone,

    role:
      role,

    verified:
      false,

    accountStatus:
      accountStatus,

    otpReady:
      false,

    otpSent:
      false,

    redirect:
      "verify.html"
  };
}


