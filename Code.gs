/* =========================================================
   30. OTP IDENTITY RESOLUTION
   ========================================================= */

function resolveOtpIdentity(data) {
  data =
    data || {};

  return (
    data.uid ||
    data.identity ||
    data.username ||
    data.gmail ||
    data.email ||
    data.phone ||
    ""
  );
}


/* =========================================================
   31. OTP CHANNEL RESOLUTION
   ========================================================= */

function resolveOtpChannel(data) {
  data =
    data || {};

  return normalizeChannel(
    data.channel ||
    "email"
  );
}


/* =========================================================
   32. PREPARE OTP
   ========================================================= */

function prepareOtp(data) {
  data =
    data || {};

  const identity =
    resolveOtpIdentity(
      data
    );

  const channel =
    resolveOtpChannel(
      data
    );

  const user =
    resolveUser(
      data
    ) ||
    findUser(identity);

  if (!user) {
    return {
      success: false,

      code:
        "ACCOUNT_NOT_FOUND",

      message:
        "Account does not exist."
    };
  }

  if (
    user.accountStatus ===
    "DISABLED"
  ) {
    return {
      success: false,

      code:
        "ACCOUNT_DISABLED",

      message:
        "This account is disabled."
    };
  }

  if (
    user.accountStatus ===
    "SUSPENDED"
  ) {
    return {
      success: false,

      code:
        "ACCOUNT_SUSPENDED",

      message:
        "This account is suspended."
    };
  }

  if (
    user.accountStatus ===
    "BLOCKED"
  ) {
    return {
      success: false,

      code:
        "ACCOUNT_BLOCKED",

      message:
        "This account is blocked."
    };
  }

  if (
    isLocked(user)
  ) {
    const lockUntil =
      toDate(
        user.otpLockUntil
      );

    return {
      success: false,

      code:
        "OTP_LOCKED",

      message:
        "Too many incorrect verification attempts. Please try again after the temporary lock expires.",

      locked: true,

      lockUntil:
        lockUntil
          ? lockUntil.toISOString()
          : null
    };
  }

  /*
   * If the user is already verified,
   * registration verification should not
   * generate another verification OTP.
   */
  if (
    user.verified &&
    user.accountStatus ===
    "VERIFIED"
  ) {
    return {
      success: false,

      code:
        "ALREADY_VERIFIED",

      message:
        "This account is already verified."
    };
  }

  /*
   * Independent cooldown:
   *
   * Email has its own timer.
   * Phone has its own timer.
   */
  if (
    isChannelOnCooldown(
      user,
      channel
    )
  ) {
    const seconds =
      cooldownSeconds(
        user,
        channel
      );

    /*
     * If an active OTP exists for the same
     * channel, return it in DEMO_MODE so
     * the frontend can display the current
     * backend OTP instead of generating
     * another one.
     */
    const activeOtp =
      safeString(
        user.otp
      );

    if (
      activeOtp &&
      !isExpired(
        user.otpExpires
      ) &&
      normalizeChannel(
        user.otpChannel
      ) === channel
    ) {
      const existingDelivery = {
        channel: channel,
        emailSent:
          false,
        smsSent:
          false,
        delivered:
          false
      };

      return otpResponse(
        user,
        activeOtp,
        channel,
        existingDelivery,
        "A verification code is already active. Please use the current code."
      );
    }

    return {
      success: false,

      code:
        "OTP_COOLDOWN",

      message:
        "Please wait " +
        seconds +
        " seconds before requesting another " +
        channel +
        " code.",

      cooldownSeconds:
        seconds,

      channel:
        channel
    };
  }

  /*
   * Generate REAL OTP on the backend.
   */
  const otp =
    generateOTP();

  /*
   * Save same OTP to Sheet + Firebase.
   */
  try {
    saveOtp(
      user,
      otp,
      channel
    );
  } catch (error) {
    return {
      success: false,

      code:
        "OTP_STORAGE_FAILED",

      message:
        "The verification code could not be stored. Please try again.",

      detail:
        safeString(
          error.message
        )
    };
  }

  /*
   * Reload user so timestamps and OTP
   * fields are current.
   */
  const updatedUser =
    findUser(
      user.uid
    ) || user;

  /*
   * Deliver OTP through selected channel.
   */
  const delivery =
    sendOTPByChannel(
      updatedUser,
      otp,
      channel
    );

  /*
   * SCHOOL DEMO MODE:
   *
   * We return the REAL generated OTP.
   *
   * We do NOT say that email/SMS was sent
   * if the provider is unavailable.
   */
  if (DEMO_MODE) {

    let message =
      "Verification code is ready.";

    if (
      delivery.delivered
    ) {
      message =
        channel === "email"
          ? "Verification code generated and sent by email."
          : "Verification code generated and sent by phone.";
    } else {
      message =
        "Verification code generated by the backend. Demo mode is enabled because delivery service is not configured.";
    }

    return otpResponse(
      updatedUser,
      otp,
      channel,
      delivery,
      message
    );
  }

  /*
   * PRODUCTION MODE:
   *
   * If the selected delivery method fails,
   * remove the OTP so it cannot be used.
   */
  if (
    !delivery.delivered
  ) {
    clearOtpCompletely(
      updatedUser
    );

    return {
      success: false,

      code:
        "OTP_DELIVERY_FAILED",

      message:
        channel === "email"
          ? "The verification email could not be sent."
          : "The verification SMS could not be sent."
    };
  }

  return otpResponse(
    updatedUser,
    otp,
    channel,
    delivery,
    channel === "email"
      ? "Verification code sent by email."
      : "Verification code sent by phone."
  );
}


/* =========================================================
   33. GENERATE OTP COMPATIBILITY
   ========================================================= */

function generateOtp(data) {
  return prepareOtp(
    data
  );
}


/* =========================================================
   34. RESEND OTP
   ========================================================= */

function resendOTP(data) {
  /*
   * Resend uses the same backend OTP generation
   * mechanism, but requires the current channel
   * cooldown to have expired.
   */
  return prepareOtp(
    data
  );
}


/* =========================================================
   35. REQUEST OTP COMPATIBILITY
   ========================================================= */

function requestOtp(data) {
  return resendOTP(
    data
  );
}


/* =========================================================
   36. VERIFY REGISTRATION OTP
   ========================================================= */

function verifyOTP(data) {
  data =
    data || {};

  const identity =
    resolveOtpIdentity(
      data
    );

  const otp =
    safeString(
      data.otp ||
      data.code
    ).replace(
      /\D/g,
      ""
    );

  if (
    otp.length !== OTP_LENGTH
  ) {
    return {
      success: false,

      code:
        "INVALID_OTP_FORMAT",

      message:
        "Please enter the complete 6-digit verification code."
    };
  }

  const user =
    resolveUser(
      data
    ) ||
    findUser(identity);

  if (!user) {
    return {
      success: false,

      code:
        "ACCOUNT_NOT_FOUND",

      message:
        "Account does not exist."
    };
  }

  if (
    user.accountStatus ===
    "DISABLED"
  ) {
    return {
      success: false,

      code:
        "ACCOUNT_DISABLED",

      message:
        "This account is disabled."
    };
  }

  if (
    user.accountStatus ===
    "SUSPENDED"
  ) {
    return {
      success: false,

      code:
        "ACCOUNT_SUSPENDED",

      message:
        "This account is suspended."
    };
  }

  if (
    user.accountStatus ===
    "BLOCKED"
  ) {
    return {
      success: false,

      code:
        "ACCOUNT_BLOCKED",

      message:
        "This account is blocked."
    };
  }

  if (
    user.verified
  ) {
    return {
      success: true,

      code:
        "ALREADY_VERIFIED",

      message:
        "Account is already verified.",

      uid:
        user.uid,

      username:
        user.username,

      name:
        user.name,

      gmail:
        user.gmail,

      email:
        user.gmail,

      phone:
        user.phone,

      role:
        user.role,

      verified:
        true,

      accountStatus:
        "VERIFIED"
    };
  }

  if (
    isLocked(user)
  ) {
    const lockUntil =
      toDate(
        user.otpLockUntil
      );

    return {
      success: false,

      code:
        "OTP_LOCKED",

      message:
        "Too many incorrect verification attempts. Please wait until the temporary lock expires.",

      locked: true,

      lockUntil:
        lockUntil
          ? lockUntil.toISOString()
          : null
    };
  }

  if (
    !user.otp
  ) {
    return {
      success: false,

      code:
        "OTP_NOT_READY",

      message:
        "No verification code is currently active. Please request a new code."
    };
  }

  if (
    isExpired(
      user.otpExpires
    )
  ) {
    clearOtpCompletely(
      user
    );

    return {
      success: false,

      code:
        "OTP_EXPIRED",

      message:
        "The verification code has expired. Please request a new code."
    };
  }

  /*
   * Compare server-stored OTP with
   * user-provided OTP.
   */
  if (
    otp !==
    safeString(user.otp)
  ) {
    const newAttempts =
      (Number(
        user.otpAttempts
      ) || 0) + 1;

    let lockUntil = "";

    if (
      newAttempts >=
      OTP_MAX_ATTEMPTS
    ) {
      lockUntil =
        new Date(
          new Date().getTime() +
          OTP_LOCK_MS
        );
    }

    const sheet =
      getSheet();

    sheet
      .getRange(
        user.rowNumber,
        13
      )
      .setValue(
        newAttempts
      );

    if (lockUntil) {
      sheet
        .getRange(
          user.rowNumber,
          14
        )
        .setValue(
          lockUntil
        );
    }

    try {
      updateFirebaseOtpAttempts(
        user,
        newAttempts,
        lockUntil
      );
    } catch (error) {
      console.warn(
        "Firebase OTP attempt sync failed: " +
        error.message
      );
    }

    if (
      newAttempts >=
      OTP_MAX_ATTEMPTS
    ) {
      return {
        success: false,

        code:
          "OTP_LOCKED",

        message:
          "You entered the wrong code 4 times. Your account verification is temporarily locked for 30 minutes.",

        locked: true,

        attempts:
          newAttempts,

        lockUntil:
          lockUntil.toISOString()
      };
    }

    return {
      success: false,

      code:
        "INVALID_OTP",

      message:
        "Incorrect verification code. Please try again.",

      attempts:
        newAttempts,

      remainingAttempts:
        OTP_MAX_ATTEMPTS -
        newAttempts
    };
  }

  /*
   * OTP is correct.
   *
   * Mark account verified.
   */
  const sheet =
    getSheet();

  const verifiedAt =
    new Date();

  sheet
    .getRange(
      user.rowNumber,
      6
    )
    .setValue(
      "VERIFIED"
    );

  sheet
    .getRange(
      user.rowNumber,
      10
    )
    .setValue(
      true
    );

  sheet
    .getRange(
      user.rowNumber,
      13
    )
    .setValue(
      0
    );

  sheet
    .getRange(
      user.rowNumber,
      14
    )
    .clearContent();

  sheet
    .getRange(
      user.rowNumber,
      17
    )
    .setValue(
      verifiedAt
    );

  /*
   * Clear OTP after successful verification.
   */
  clearSheetOtp(
    user
  );

  /*
   * Update Firebase with the ACTUAL
   * account status.
   */
  const updatedUser =
    findUser(
      user.uid
    ) || user;

  try {
    syncFirebaseAccountStatus(
      updatedUser,
      "VERIFIED"
    );

    clearFirebaseOtpFields(
      updatedUser
    );

  } catch (error) {
    /*
     * Sheet remains authoritative for this
     * school project, but report Firebase
     * synchronization failure.
     */
    console.warn(
      "Firebase verification sync failed: " +
      error.message
    );
  }

  const finalUser =
    findUser(
      user.uid
    ) || updatedUser;

  return {
    success: true,

    code:
      "ACCOUNT_VERIFIED",

    message:
      "Account verified successfully.",

    uid:
      finalUser.uid,

    username:
      finalUser.username,

    name:
      finalUser.name,

    gmail:
      finalUser.gmail,

    email:
      finalUser.gmail,

    phone:
      finalUser.phone,

    role:
      finalUser.role,

    verified:
      true,

    accountStatus:
      "VERIFIED",

    redirect:
      "dashboard.html"
  };
}


/* =========================================================
   37. LOGIN
   ========================================================= */

function loginUser(data) {
  data =
    data || {};

  const identity =
    safeString(
      data.identity ||
      data.username ||
      data.email ||
      data.gmail ||
      data.phone
    );

  const password =
    safeString(
      data.password
    );

  if (!identity) {
    return {
      success: false,

      code:
        "IDENTITY_REQUIRED",

      message:
        "Please enter your username, email, or phone number."
    };
  }

  if (!password) {
    return {
      success: false,

      code:
        "PASSWORD_REQUIRED",

      message:
        "Please enter your password."
    };
  }

  const user =
    findUser(
      identity
    );

  /*
   * IMPORTANT:
   * This now returns a clear business error
   * instead of being converted into a network
   * error by the frontend API layer.
   */
  if (!user) {
    return {
      success: false,

      code:
        "ACCOUNT_NOT_FOUND",

      message:
        "Account does not exist."
    };
  }

  if (
    user.accountStatus ===
    "SUSPENDED"
  ) {
    return {
      success: false,

      code:
        "ACCOUNT_SUSPENDED",

      message:
        "This account is suspended."
    };
  }

  if (
    user.accountStatus ===
    "DISABLED"
  ) {
    return {
      success: false,

      code:
        "ACCOUNT_DISABLED",

      message:
        "This account is disabled."
    };
  }

  if (
    user.accountStatus ===
    "BLOCKED"
  ) {
    return {
      success: false,

      code:
        "ACCOUNT_BLOCKED",

      message:
        "This account is blocked."
    };
  }

  /*
   * Password remains compatible with your
   * current USER sheet structure.
   */
  if (
    safeString(
      user.password
    ) !== password
  ) {
    return {
      success: false,

      code:
        "INVALID_CREDENTIALS",

      message:
        "Incorrect username/email/phone or password."
    };
  }

  /*
   * Pending/unverified account.
   */
  if (
    !user.verified ||
    user.accountStatus !==
    "VERIFIED"
  ) {
    return {
      success: false,

      code:
        "REQUIRES_VERIFICATION",

      message:
        "Account is not verified. Please verify your OTP.",

      verified:
        false,

      requiresVerification:
        true,

      needsVerification:
        true,

      uid:
        user.uid,

      username:
        user.username,

      gmail:
        user.gmail,

      email:
        user.gmail,

      phone:
        user.phone,

      role:
        user.role,

      accountStatus:
        user.accountStatus
    };
  }

  /*
   * Successful login.
   */
  const sheet =
    getSheet();

  sheet
    .getRange(
      user.rowNumber,
      19
    )
    .setValue(
      new Date()
    );

  const finalUser =
    findUser(
      user.uid
    ) || user;

  return {
    success: true,

    code:
      "LOGIN_SUCCESS",

    message:
      "Login successful.",

    uid:
      finalUser.uid,

    username:
      finalUser.username,

    name:
      finalUser.name,

    gmail:
      finalUser.gmail,

    email:
      finalUser.gmail,

    phone:
      finalUser.phone,

    role:
      finalUser.role,

    age:
      finalUser.age,

    verified:
      true,

    accountStatus:
      "VERIFIED",

    redirect:
      "dashboard.html"
  };
}


/* =========================================================
   38. GET USER
   ========================================================= */

function getUser(data) {
  data =
