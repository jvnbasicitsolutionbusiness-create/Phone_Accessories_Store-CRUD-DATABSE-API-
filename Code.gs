    "LAST OTP SENT",
    "LAST LOGIN",
    "LAST EMAIL OTP SENT",
    "LAST PHONE OTP SENT"

];


/* =========================================================
   GENERAL HELPERS
   ========================================================= */

function safeString(value) {

    return String(
        value === null ||
        value === undefined
            ? ""
            : value
    ).trim();

}


function normalizeEmail(value) {

    return safeString(
        value
    ).toLowerCase();

}


function normalizeUsername(value) {

    return safeString(
        value
    ).toLowerCase();

}


function normalizePhone(value) {

    let phone =
        safeString(value)
            .replace(/\s+/g, "");


    if (
        phone.indexOf("+63") === 0
    ) {

        phone =
            "0" +
            phone.substring(3);

    }


    if (
        phone.indexOf("63") === 0 &&
        phone.length === 12
    ) {

        phone =
            "0" +
            phone.substring(2);

    }


    return phone;

}


function normalizeChannel(value) {

    const channel =
        safeString(value)
            .toLowerCase();


    if (
        channel === "phone" ||
        channel === "sms"
    ) {

        return "phone";

    }


    if (
        channel === "both"
    ) {

        return "both";

    }


    return "email";

}


function normalizeStatus(value) {

    const status =
        safeString(value)
            .toUpperCase();


    if (
        status === "VERIFIED"
    ) {

        return "VERIFIED";

    }


    if (
        status === "SUSPENDED"
    ) {

        return "SUSPENDED";

    }


    if (
        status === "DISABLED"
    ) {

        return "DISABLED";

    }


    if (
        status === "BLOCKED"
    ) {

        return "BLOCKED";

    }


    return "PENDING";

}


function normalizeRole(value) {

    const role =
        safeString(value)
            .toLowerCase();


    if (
        role === "admin" ||
        role === "administrator"
    ) {

        return "Admin";

    }


    if (
        role === "manager"
    ) {

        return "Manager";

    }


    return "Employee";

}


/* =========================================================
   DATE HELPERS
   ========================================================= */

function now() {

    return new Date();

}


function addMinutes(
    date,
    minutes
) {

    return new Date(
        date.getTime() +
        Number(minutes) * 60 * 1000
    );

}


function addSeconds(
    date,
    seconds
) {

    return new Date(
        date.getTime() +
        Number(seconds) * 1000
    );

}


function parseDate(value) {

    if (!value) {
        return null;
    }


    if (
        Object.prototype.toString.call(value) ===
        "[object Date]"
    ) {

        return isNaN(
            value.getTime()
        )
            ? null
            : value;

    }


    const date =
        new Date(value);


    if (
        isNaN(
            date.getTime()
        )
    ) {

        return null;

    }


    return date;

}


/* =========================================================
   BOOLEAN HELPERS
   ========================================================= */

function toBoolean(value) {

    if (
        value === true
    ) {

        return true;

    }


    const text =
        safeString(value)
            .toLowerCase();


    return (
        text === "true" ||
        text === "yes" ||
        text === "1"
    );

}


/* =========================================================
   UID
   ========================================================= */

function generateUID() {

    return (
        "SF-" +
        Utilities.getUuid()
            .replace(/-/g, "")
            .substring(0, 16)
            .toUpperCase()
    );

}


/* =========================================================
   OTP GENERATION
   ========================================================= */

function generateOTP() {

    /*
     * IMPORTANT:
     *
     * OTP generation exists ONLY in Code.gs.
     *
     * verify.js and recovery.js never generate OTPs.
     */

    let otp = "";


    for (
        let i = 0;
        i < OTP_LENGTH;
        i++
    ) {

        otp += Math.floor(
            Math.random() * 10
        );

    }


    return otp;

}


/* =========================================================
   SHEET
   ========================================================= */

function getSheet() {

    const spreadsheet =
        SpreadsheetApp.openById(
            SHEET_ID
        );


    let sheet =
        spreadsheet.getSheetByName(
            SHEET_NAME
        );


    if (!sheet) {

        sheet =
            spreadsheet.insertSheet(
                SHEET_NAME
            );

    }


    ensureHeaders(
        sheet
    );


    return sheet;

}


function ensureHeaders(
    sheet
) {

    const required =
        HEADERS.length;


    const currentColumns =
        Math.max(
            sheet.getMaxColumns(),
            required
        );


    if (
        sheet.getMaxColumns() <
        required
    ) {

        sheet.insertColumnsAfter(
            sheet.getMaxColumns(),
            required -
            sheet.getMaxColumns()
        );

    }


    const current =
        sheet
            .getRange(
                1,
                1,
                1,
                required
            )
            .getValues()[0];


    let needsUpdate =
        false;


    for (
        let i = 0;
        i < required;
        i++
    ) {

        if (
            safeString(
                current[i]
            ) !==
            HEADERS[i]
        ) {

            needsUpdate =
                true;

            break;

        }

    }


    if (needsUpdate) {

        sheet
            .getRange(
                1,
                1,
                1,
                required
            )
            .setValues([
                HEADERS
            ]);

    }

}


function getRows() {

    const sheet =
        getSheet();


    const lastRow =
        sheet.getLastRow();


    if (
        lastRow < 2
    ) {

        return [];

    }


    const values =
        sheet
            .getRange(
                2,
                1,
                lastRow - 1,
                HEADERS.length
            )
            .getValues();


    return values.map(
        (
            row,
            index
        ) => {

            const user = {};


            HEADERS.forEach(
                (
                    header,
                    column
                ) => {

                    user[header] =
                        row[column];

                }
            );


            user._row =
                index + 2;


            return user;

        }
    );

}


/* =========================================================
   USER OBJECT
   ========================================================= */

function userToResponse(
    user
) {

    if (!user) {

        return null;

    }


    return {

        uid:
            safeString(
                user["UID"]
            ),

        name:
            safeString(
                user["NAME"]
            ),

        username:
            safeString(
                user["USERNAME"]
            ),

        age:
            user["AGE"],

        accountStatus:
            normalizeStatus(
                user["ACCOUNT_S"]
            ),

        gmail:
            normalizeEmail(
                user["GMAIL"]
            ),

        email:
            normalizeEmail(
                user["GMAIL"]
            ),

        phone:
            normalizePhone(
                user["PHONE NO."]
            ),

        role:
            normalizeRole(
                user["ROLE"]
            ),

        verified:
            toBoolean(
                user["VERIFIED"]
            ),

        createdAt:
            user["CREATED AT"] || "",

        verifiedAt:
            user["VERIFIED AT"] || "",

