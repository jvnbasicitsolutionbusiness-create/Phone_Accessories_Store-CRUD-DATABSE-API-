/* =========================================================
   USER LOOKUP
   ========================================================= */

function findUser(
    identity
) {

    const value =
        safeString(identity);


    if (!value) {

        return null;

    }


    const normalized =
        value.toLowerCase();


    const phone =
        normalizePhone(
            value
        );


    const rows =
        getRows();


    for (
        let i = 0;
        i < rows.length;
        i++
    ) {

        const user =
            rows[i];


        const uid =
            safeString(
                user["UID"]
            )
                .toLowerCase();


        const username =
            normalizeUsername(
                user["USERNAME"]
            );


        const gmail =
            normalizeEmail(
                user["GMAIL"]
            );


        const userPhone =
            normalizePhone(
                user["PHONE NO."]
            );


        if (
            uid === normalized ||
            username === normalized ||
            gmail === normalized ||
            (
                phone &&
                userPhone &&
                phone === userPhone
            )
        ) {

            return user;

        }

    }


    return null;

}


function findUserByUid(
    uid
) {

    const value =
        safeString(uid);


    if (!value) {
        return null;
    }


    const rows =
        getRows();


    for (
        let i = 0;
        i < rows.length;
        i++
    ) {

        if (
            safeString(
                rows[i]["UID"]
            ) === value
        ) {

            return rows[i];

        }

    }


    return null;

}


/* =========================================================
   DUPLICATE CHECK
   ========================================================= */

function findDuplicateUser(
    username,
    gmail,
    phone
) {

    const normalizedUsername =
        normalizeUsername(
            username
        );


    const normalizedGmail =
        normalizeEmail(
            gmail
        );


    const normalizedPhone =
        normalizePhone(
            phone
        );


    const rows =
        getRows();


    for (
        let i = 0;
        i < rows.length;
        i++
    ) {

        const user =
            rows[i];


        if (
            normalizeUsername(
                user["USERNAME"]
            ) ===
            normalizedUsername
        ) {

            return {
                user,
                code:
                    "USERNAME_EXISTS"
            };

        }


        if (
            normalizeEmail(
                user["GMAIL"]
            ) ===
            normalizedGmail
        ) {

            return {
                user,
                code:
                    "EMAIL_EXISTS"
            };

        }


        if (
            normalizePhone(
                user["PHONE NO."]
            ) ===
            normalizedPhone
        ) {

            return {
                user,
                code:
                    "PHONE_EXISTS"
            };

        }

    }


    return null;

}


/* =========================================================
   VALIDATION
   ========================================================= */

function validateRegistrationData(
    data
) {

    const firstName =
        safeString(
            data.firstName
        );


    const lastName =
        safeString(
            data.lastName
        );


    const name =
        safeString(
            data.name ||
            (
                firstName +
                " " +
                lastName
            )
        );


    const username =
        normalizeUsername(
            data.username
        );


    const age =
        Number(
            data.age
        );


    const gmail =
        normalizeEmail(
            data.gmail ||
            data.email
        );


    const phone =
        normalizePhone(
            data.phone
        );


    const password =
        safeString(
            data.password
        );


    if (
        !firstName ||
        firstName.length < 2
    ) {

        return {
            valid: false,
            code:
                "INVALID_FIRST_NAME",
            message:
                "Please enter a valid first name."
        };

    }


    if (
        !lastName ||
        lastName.length < 2
    ) {

        return {
            valid: false,
            code:
                "INVALID_LAST_NAME",
            message:
                "Please enter a valid last name."
        };

    }


    if (
        !username ||
        username.length < 4 ||
        username.length > 30 ||
        !/^[a-zA-Z0-9._]+$/.test(
            username
        )
    ) {

        return {
            valid: false,
            code:
                "INVALID_USERNAME",
            message:
                "Username must be 4–30 characters and may contain only letters, numbers, dots, and underscores."
        };

    }


    if (
        !Number.isInteger(age) ||
        age < 18 ||
        age > 100
    ) {

        return {
            valid: false,
            code:
                "INVALID_AGE",
            message:
                "Age must be between 18 and 100."
        };

    }


    if (
        !/^[^\s@]+@gmail\.com$/i.test(
            gmail
        )
    ) {

        return {
            valid: false,
            code:
                "INVALID_GMAIL",
            message:
                "Please enter a valid Gmail address ending in @gmail.com."
        };

    }


    if (
        !/^09\d{9}$/.test(
            phone
        )
    ) {

        return {
            valid: false,
            code:
                "INVALID_PHONE",
            message:
                "Please enter a valid Philippine mobile number in 09XXXXXXXXX format."
        };

    }


    if (
        password.length < 8
    ) {

        return {
            valid: false,
            code:
                "INVALID_PASSWORD",
            message:
                "Password must be at least 8 characters."
        };

    }


    if (
        !/[A-Z]/.test(
            password
        ) ||
        !/[a-z]/.test(
            password
        ) ||
        !/\d/.test(
            password
        ) ||
        !/[^A-Za-z0-9]/.test(
            password
        )
    ) {

        return {
            valid: false,
            code:
                "INVALID_PASSWORD",
            message:
                "Password must include uppercase, lowercase, number, and special character."
        };

    }


    if (
        data.confirmPassword !==
        undefined &&
        safeString(
            data.confirmPassword
        ) !== password
    ) {

        return {
            valid: false,
            code:
                "PASSWORD_MISMATCH",
            message:
                "Passwords do not match."
        };

    }


    return {

        valid: true,

        data: {

            firstName,
            lastName,
            name,
            username,
            age,
            gmail,
            phone,
            password

        }

    };

}


/* =========================================================
   FIREBASE HELPERS
   ========================================================= */

function firebaseBaseUrl() {

    return FIREBASE_URL.replace(
        /\/+$/,
        ""
    );

}


function firebaseRequest(
    path,
    method,
    payload
) {

    const url =
        firebaseBaseUrl() +
        "/" +
        path.replace(
            /^\/+/,
            ""
        ) +
        ".json";


    const options = {

        method:
            method || "get",

        muteHttpExceptions:
            true,

        contentType:
            "application/json"

    };


    if (
        payload !== undefined &&
        payload !== null
    ) {

        options.payload =
            JSON.stringify(
                payload
            );

    }


    const response =
        UrlFetchApp.fetch(
            url,
            options
        );


    const code =
        response.getResponseCode();


    const text =
        response.getContentText();


    if (
        code < 200 ||
        code >= 300
    ) {

        throw new Error(
            "Firebase request failed: HTTP " +
            code +
            " " +
            text
        );

    }


    if (!text) {
        return null;
    }


    try {

        return JSON.parse(
            text
        );

    } catch (error) {

        return text;

    }

}


function firebaseUserPath(
    uid
) {

    return (
        "stockflow/users/" +
        encodeURIComponent(
            uid
        )
    );

}


/* =========================================================
   FIREBASE USER SAVE
   ========================================================= */

function saveFirebaseUser(
    user
) {

    if (!user) {
        return false;
    }


    const uid =
        safeString(
            user["UID"]
        );


    if (!uid) {
        return false;
    }


    /*
     * IMPORTANT:
     *
     * Password is intentionally NOT written to Firebase.
     *
     * The existing school-project Sheet continues to contain
     * the password because that is part of the existing schema.
     */

    const payload = {

        uid,

        name:
            safeString(
                user["NAME"]
            ),

        username:
            safeString(
                user["USERNAME"]
            ),

        age:
            Number(
                user["AGE"]
            ),

        gmail:
            normalizeEmail(
                user["GMAIL"]
            ),

        phone:
            normalizePhone(
                user["PHONE NO."]
            ),

        role:
            normalizeRole(
                user["ROLE"]
            ),

        verified:
            toBoolean(
                user["VERIFIED"]
            ),

        accountStatus:
            normalizeStatus(
                user["ACCOUNT_S"]
            ),

        createdAt:
            user["CREATED AT"] || "",

        verifiedAt:
            user["VERIFIED AT"] || "",

        lastLogin:
            user["LAST LOGIN"] || ""

    };


    firebaseRequest(
        firebaseUserPath(
            uid
        ),
        "put",
        payload
    );


    return true;

}


/* =========================================================
   FIREBASE OTP
   ========================================================= */

function saveOtpToFirebase(
    user,
    otp,
    channel,
    expiresAt,
    attempts,
    lockUntil
) {

    const uid =
        safeString(
            user["UID"]
        );


    if (!uid) {
        throw new Error(
            "Missing UID for Firebase OTP storage."
        );
    }


    const payload = {

        otp:
            safeString(
                otp
            ),

        channel:
            normalizeChannel(
                channel
            ),

        expiresAt:
            expiresAt
                .toISOString(),

        attempts:
            Number(
                attempts || 0
            ),

        lockUntil:
            lockUntil
                ? lockUntil.toISOString()
                : "",

        updatedAt:
            now().toISOString()

    };


    firebaseRequest(
        firebaseUserPath(
            uid
        ) +
        "/otp",
        "put",
        payload
    );


    return true;

}


function updateFirebaseOtpAttempts(
    user,
    attempts,
    lockUntil
) {

    const uid =
        safeString(
            user["UID"]
        );


    if (!uid) {
        return false;
    }


    const payload = {

        attempts:
            Number(
                attempts || 0
            ),

        lockUntil:
            lockUntil
                ? lockUntil.toISOString()
                : "",

        updatedAt:
            now().toISOString()

    };


    firebaseRequest(
        firebaseUserPath(
            uid
        ) +
        "/otp",
        "patch",
        payload
    );


    return true;

}


function clearFirebaseOtpFields(
    user
) {

    const uid =
        safeString(
            user["UID"]
        );


    if (!uid) {
        return false;
    }


    firebaseRequest(
        firebaseUserPath(
            uid
        ) +
        "/otp",
        "delete"
    );


    return true;

}


/* =========================================================
   FIREBASE VERIFIED / STATUS SYNC
   ========================================================= */

function syncFirebaseUserStatus(
    user,
    status,
    verified
) {

    const uid =
        safeString(
            user["UID"]
        );


    if (!uid) {
        return false;
    }


    const normalizedStatus =
        normalizeStatus(
            status
        );


    const payload = {

        accountStatus:
            normalizedStatus,

        verified:
            Boolean(
                verified
            ),

        statusUpdatedAt:
            now().toISOString()

    };


    firebaseRequest(
        firebaseUserPath(
            uid
        ),
        "patch",
        payload
    );


    return true;

}


/* =========================================================
   EMAIL
   ========================================================= */

function escapeHtml(value) {

    return safeString(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");

}


function sendEmailOTP(
    email,
    otp,
    recipientName
) {

    const destination =
        normalizeEmail(
            email
        );


    if (!destination) {

        return {

            success: false,

            sent: false,

            configured: false,

            message:
                "No Gmail address is registered."

        };

    }


    const safeOtp =
        escapeHtml(otp);


    const safeBrand =
        escapeHtml(EMAIL_BRAND_NAME);


    const safeFooter =
        escapeHtml(EMAIL_FOOTER);


    const safeRecipientName =
        escapeHtml(
            recipientName ||
            "there"
        );


    const subject =
        EMAIL_BRAND_NAME +
        " - Your verification code";


    const plainBody =
        EMAIL_BRAND_NAME +
        "\n\n" +
        "Hello " +
        safeString(recipientName || "there") +
        ",\n\n" +
        "Your verification code is:\n\n" +
        safeString(otp) +
        "\n\n" +
        "This code expires in " +
        OTP_EXPIRATION_MINUTES +
        " minutes.\n\n" +
        "If you did not request this verification code, you can ignore this email.\n\n" +
        EMAIL_FOOTER;


    const htmlBody =
        '<div style="font-family:Arial,Helvetica,sans-serif;max-width:760px;margin:0 auto;padding:24px;color:#111827;line-height:1.6;">' +
            '<div style="font-size:28px;font-weight:700;color:#2563eb;margin-bottom:28px;">' +
                safeBrand +
            '</div>' +
            '<div style="font-size:20px;margin-bottom:24px;">Hello ' +
                safeRecipientName +
                ',</div>' +
            '<div style="font-size:20px;margin-bottom:18px;">Your verification code is:</div>' +
            '<div style="background:#dfe4ea;border-radius:18px;padding:34px 20px;text-align:center;margin:26px 0 32px;">' +
                '<div style="font-size:50px;line-height:1;font-weight:700;letter-spacing:12px;color:#10213f;">' +
                    safeOtp +
                '</div>' +
            '</div>' +
            '<div style="font-size:20px;margin-bottom:24px;">This code expires in <strong>' +
                OTP_EXPIRATION_MINUTES +
                ' minutes.</strong></div>' +
            '<div style="font-size:18px;color:#64748b;margin-bottom:22px;">If you did not request this verification code, you can ignore this email.</div>' +
            '<div style="font-size:18px;color:#777777;">' +
                safeFooter +
            '</div>' +
        '</div>';


    MailApp.sendEmail({

        to:
            destination,

        subject:
            subject,

        body:
            plainBody,

        htmlBody:
            htmlBody,

        name:
            EMAIL_SENDER_NAME

    });


    return {

        success: true,

        sent: true,

        configured: true,

        senderName:
            EMAIL_SENDER_NAME,

        brandName:
            EMAIL_BRAND_NAME

    };

}


/* =========================================================
   TWILIO
   ========================================================= */

function getTwilioSettings() {

    const properties =
        PropertiesService
            .getScriptProperties();


    return {

        accountSid:
            safeString(
                properties.getProperty(
                    "TWILIO_ACCOUNT_SID"
                )
            ),

        authToken:
            safeString(
                properties.getProperty(
                    "TWILIO_AUTH_TOKEN"
                )
            ),

        phoneNumber:
            safeString(
                properties.getProperty(
                    "TWILIO_PHONE_NUMBER"
                )
            )

    };

}


function sendPhoneOTP(
    phone,
    otp
) {

    const destination =
        normalizePhone(
            phone
        );


    if (!destination) {

        return {

            success: false,

            sent: false,

            message:
                "No registered phone number is available."

        };

    }


    const settings =
        getTwilioSettings();


    if (
        !settings.accountSid ||
        !settings.authToken ||
        !settings.phoneNumber
    ) {

        return {

            success: false,

            sent: false,

            configured: false,

            message:
                "Phone OTP delivery is not configured."

        };

    }


    const url =
        "https://api.twilio.com/2010-04-01/Accounts/" +
        encodeURIComponent(
            settings.accountSid
        ) +
        "/Messages.json";


    const payload = {

        To:
            "+63" +
            destination.substring(1),

        From:
            settings.phoneNumber,

        Body:
            APP_NAME +
            " verification code: " +
            otp +
            ". Expires in " +
            OTP_EXPIRATION_MINUTES +
            " minutes."

    };


    const authorization =
        Utilities.base64Encode(
            settings.accountSid +
            ":" +
            settings.authToken
        );


    const response =
        UrlFetchApp.fetch(
            url,
            {

                method:
                    "post",

                muteHttpExceptions:
                    true,

                headers: {

                    Authorization:
                        "Basic " +
                        authorization

                },

                payload

            }
        );


    const code =
        response.getResponseCode();


    if (
        code < 200 ||
        code >= 300
    ) {

        throw new Error(
            "Twilio phone delivery failed: HTTP " +
            code +
            " " +
            response.getContentText()
        );

    }


    return {

        success: true,

        sent: true,

        configured: true

    };

}


/* =========================================================
   OTP DELIVERY
   ========================================================= */

function sendOTPByChannel(
    user,
    otp,
    channel
) {

    const selectedChannel =
        normalizeChannel(
            channel
        );


    const result = {

        emailSent:
            false,

        smsSent:
            false,

        emailAttempted:
            false,

        smsAttempted:
            false,

        emailError:
            "",

        smsError:
            "",

        deliveryConfigured:
            false

    };


    if (
        selectedChannel === "email" ||
        selectedChannel === "both"
    ) {

        result.emailAttempted =
            true;


        try {

            const emailResult =
                sendEmailOTP(
                    user["GMAIL"],
                    otp,
                    user["NAME"]
                );


            result.emailSent =
                Boolean(
                    emailResult.sent
                );


            if (
                emailResult.configured !==
                false
            ) {

                result.deliveryConfigured =
                    true;

            }

        } catch (error) {

            result.emailError =
                safeString(
                    error.message
                );

        }

    }


    if (
        selectedChannel === "phone" ||
        selectedChannel === "both"
    ) {

        result.smsAttempted =
            true;


        try {

            const phoneResult =
                sendPhoneOTP(
                    user["PHONE NO."],
                    otp
                );


            result.smsSent =
                Boolean(
                    phoneResult.sent
                );


            if (
                phoneResult.configured !==
                false
            ) {

                result.deliveryConfigured =
                    true;

            }

        } catch (error) {

            result.smsError =
                safeString(
                    error.message
                );

        }

    }


    return result;

}


/* =========================================================
   OTP SHEET STORAGE
   ========================================================= */

function saveOtp(
    user,
    otp,
    channel
) {

    const sheet =
        getSheet();


    const row =
        Number(
            user._row
        );


    if (
        !row ||
        row < 2
    ) {

        throw new Error(
            "Invalid user row for OTP storage."
        );

    }


    const generatedAt =
        now();


    const expiresAt =
        addMinutes(
            generatedAt,
            OTP_EXPIRATION_MINUTES
        );


    const attempts =
        0;


    const lockUntil =
        null;


    const timestamp =
        generatedAt;


    const normalizedChannel =
        normalizeChannel(
            channel
        );


    const channelColumn =
        HEADERS.indexOf(
            "OTP CHANNEL"
        ) + 1;


    const otpColumn =
        HEADERS.indexOf(
            "OTP"
        ) + 1;


    const expiresColumn =
        HEADERS.indexOf(
            "OTP EXPIRES"
        ) + 1;


    const attemptsColumn =
        HEADERS.indexOf(
            "OTP ATTEMPTS"
        ) + 1;


    const lockColumn =
        HEADERS.indexOf(
            "OTP LOCK UNTIL"
        ) + 1;


    const lastOtpColumn =
        HEADERS.indexOf(
            "LAST OTP SENT"
        ) + 1;


    const emailLastColumn =
        HEADERS.indexOf(
            "LAST EMAIL OTP SENT"
        ) + 1;


    const phoneLastColumn =
        HEADERS.indexOf(
            "LAST PHONE OTP SENT"
        ) + 1;


    sheet
        .getRange(
            row,
            otpColumn
        )
        .setValue(
            otp
        );


    sheet
        .getRange(
            row,
            expiresColumn
        )
        .setValue(
            expiresAt
        );


    sheet
        .getRange(
            row,
            attemptsColumn
        )
        .setValue(
            attempts
        );


    sheet
        .getRange(
            row,
            lockColumn
        )
        .setValue(
            ""
        );


    sheet
        .getRange(
            row,
            channelColumn
        )
        .setValue(
            normalizedChannel
        );


    sheet
        .getRange(
            row,
            lastOtpColumn
        )
        .setValue(
            timestamp
        );


    /*
     * Independent channel timestamps.
     */

    if (
        normalizedChannel === "email"
    ) {

        sheet
            .getRange(
                row,
                emailLastColumn
            )
            .setValue(
                timestamp
            );

    }


    if (
        normalizedChannel === "phone"
    ) {

        sheet
            .getRange(
                row,
                phoneLastColumn
            )
            .setValue(
                timestamp
            );

    }


    if (
        normalizedChannel === "both"
    ) {

        sheet
            .getRange(
                row,
                emailLastColumn
            )
            .setValue(
                timestamp
            );


        sheet
            .getRange(
                row,
                phoneLastColumn
            )
            .setValue(
                timestamp
            );

    }


    /*
     * Firebase is part of the same OTP state.
     */

    try {

        saveOtpToFirebase(
            user,
            otp,
            normalizedChannel,
            expiresAt,
            attempts,
            lockUntil
        );

    } catch (error) {

        /*
         * Roll the Sheet OTP back if Firebase storage fails.
         */

        clearSheetOtp(
            user
        );


        throw error;

    }


    return {

        otp,
        expiresAt,
        attempts,
        lockUntil,
        channel:
            normalizedChannel

    };

}


/* =========================================================
   CLEAR SHEET OTP
   ========================================================= */

function clearSheetOtp(
    user
) {

    const sheet =
        getSheet();


    const row =
        Number(
            user._row
        );


    if (
        !row ||
        row < 2
    ) {

        return false;

    }


    const columns = [

        "OTP",
        "OTP EXPIRES",
        "OTP ATTEMPTS",
        "OTP LOCK UNTIL",
        "OTP CHANNEL"

    ];


    columns.forEach(
        (header) => {

            const column =
                HEADERS.indexOf(
                    header
                ) + 1;


            if (
                column > 0
            ) {

                sheet
                    .getRange(
                        row,
                        column
                    )
                    .setValue(
                        ""
                    );

            }

        }
    );


    return true;

}


/* =========================================================
   CLEAR OTP COMPLETELY
   ========================================================= */

function clearOtpCompletely(
    user
) {

    clearSheetOtp(
        user
    );


    try {

        clearFirebaseOtpFields(
            user
        );

    } catch (error) {

        console.error(
            "Firebase OTP cleanup failed:",
            error
        );

    }


    return true;

}


/* =========================================================
   OTP COOLDOWN
   ========================================================= */

function getChannelLastSent(
    user,
    channel
) {

    const normalized =
        normalizeChannel(
            channel
        );


    if (
        normalized === "phone"
    ) {

        return parseDate(
            user["LAST PHONE OTP SENT"]
        );

    }


    return parseDate(
        user["LAST EMAIL OTP SENT"]
    );

}


function getRemainingCooldown(
    user,
    channel
) {

    const lastSent =
        getChannelLastSent(
            user,
            channel
        );


    if (!lastSent) {
        return 0;
    }


    const unlockTime =
        addSeconds(
            lastSent,
            OTP_RESEND_COOLDOWN_SECONDS
        );


    const remaining =
        Math.ceil(
            (
                unlockTime.getTime() -
                now().getTime()
            ) / 1000
        );


    return Math.max(
        0,
        remaining
    );

}


/* =========================================================
   OTP LOCK
   ========================================================= */

function getOtpLockUntil(
    user
) {

    return parseDate(
        user["OTP LOCK UNTIL"]
    );

}


function isOtpLocked(
    user
) {

    const lockUntil =
        getOtpLockUntil(
            user
        );


    if (!lockUntil) {
        return false;
    }


    return (
        lockUntil.getTime() >
        now().getTime()
    );

}


/* =========================================================
   ACTIVE OTP
   ========================================================= */

function getActiveOtp(
    user
) {

    const otp =
        safeString(
            user["OTP"]
        );


    const expiresAt =
        parseDate(
            user["OTP EXPIRES"]
        );


    if (
        !otp ||
        !expiresAt
    ) {

        return null;

    }


    if (
        expiresAt.getTime() <=
        now().getTime()
    ) {

        return null;

    }


    return {

        otp,

        expiresAt

    };

}


/* =========================================================
   OTP RESPONSE
   ========================================================= */

function buildOtpResponse(
    user,
    otpData,
    channel,
    delivery,
    message
) {

    const response = {

        success:
            true,

        code:
            "OTP_READY",

        message:
            message ||
            "Verification code is ready.",

        otpReady:
            true,

        /* OTP is never returned to frontend JavaScript. */
        otp:
            "",

        uid:
            safeString(
                user["UID"]
            ),

        username:
            safeString(
                user["USERNAME"]
            ),

        gmail:
            normalizeEmail(
                user["GMAIL"]
            ),

        email:
            normalizeEmail(
                user["GMAIL"]
            ),

        phone:
            normalizePhone(
                user["PHONE NO."]
            ),

        channel:
            normalizeChannel(
                channel
            ),

        expiresAt:
            otpData.expiresAt
                .toISOString(),

        cooldown:
            OTP_RESEND_COOLDOWN_SECONDS,

        emailSent:
            Boolean(
                delivery &&
                delivery.emailSent
            ),

        smsSent:
            Boolean(
                delivery &&
                delivery.smsSent
            ),

        deliveryConfigured:
            Boolean(
                delivery &&
                delivery.deliveryConfigured
            ),

        demoMode:
            DEMO_MODE

    };


    return response;

}


/* =========================================================
   OTP IDENTITY
   ========================================================= */

function resolveOtpIdentity(
    data
) {

    const identity =
        safeString(
            data.identity
        );


    if (identity) {

        const user =
            findUser(
                identity
            );


        if (user) {
            return user;
        }

    }


    const uid =
        safeString(
            data.uid
        );


    if (uid) {

        const user =
            findUserByUid(
                uid
            );


        if (user) {
            return user;
        }

    }


    const username =
        normalizeUsername(
            data.username
        );


    if (username) {

        const user =
            findUser(
                username
            );


        if (user) {
            return user;
        }

    }


    const email =
        normalizeEmail(
            data.email ||
            data.gmail
        );


    if (email) {

        const user =
            findUser(
                email
            );


        if (user) {
            return user;
        }

    }


    const phone =
        normalizePhone(
            data.phone
        );


    if (phone) {

        const user =
            findUser(
                phone
            );


        if (user) {
            return user;
        }

    }


    return null;

}


/* =========================================================
   OTP CHANNEL
   ========================================================= */

function resolveOtpChannel(
    data
) {

    const channel =
        normalizeChannel(
            data.channel
        );


    return channel;

}


/* =========================================================
   PREPARE OTP
   ========================================================= */

function prepareOtp(
    data
) {

    data =
        data || {};


    const purpose =
        safeString(
            data.purpose
        ).toLowerCase();


    const isRecoveryRequest =
        purpose === "recovery" ||
        purpose === "password_recovery" ||
        purpose === "forgot_password";


    const user =
        resolveOtpIdentity(
            data
        );


    if (!user) {

        return {

            success: false,

            code:
                "ACCOUNT_NOT_FOUND",

            message:
                "Account does not exist."

        };

    }


    const status =
        normalizeStatus(
            user["ACCOUNT_S"]
        );


    if (
        status === "DISABLED"
    ) {

        return {

            success: false,

            code:
                "ACCOUNT_DISABLED",

            message:
                "This account is disabled."

        };

    }


    if (
        status === "SUSPENDED"
    ) {

        return {

            success: false,

            code:
                "ACCOUNT_SUSPENDED",

            message:
                "This account is suspended."

        };

    }


    if (
        status === "BLOCKED"
    ) {

        return {

            success: false,

            code:
                "ACCOUNT_BLOCKED",

            message:
                "This account is blocked."

        };

    }


    if (
        toBoolean(
            user["VERIFIED"]
        ) &&
        !isRecoveryRequest
    ) {

        return {

            success: false,

            code:
                "ALREADY_VERIFIED",

            message:
                "This account is already verified."

        };

    }


    if (
        isOtpLocked(
            user
        )
    ) {

        const lockUntil =
            getOtpLockUntil(
                user
            );


        return {

            success: false,

            code:
                "OTP_LOCKED",

            message:
                "Too many incorrect attempts. Please try again after the temporary lock expires.",

            lockUntil:
                lockUntil
                    ? lockUntil.toISOString()
                    : ""

        };

    }


    const channel =
        resolveOtpChannel(
            data
        );


    /*
     * BOTH is allowed internally, but the frontend buttons
     * use independent email/phone channels.
     */

    if (
        channel !== "email" &&
        channel !== "phone" &&
        channel !== "both"
    ) {

        return {

            success: false,

            code:
                "INVALID_OTP_CHANNEL",

            message:
                "Invalid verification method."

        };

    }


    /*
     * Independent cooldown.
     *
     * Email cooldown does NOT block phone.
     * Phone cooldown does NOT block email.
     */

    if (
        channel === "email" ||
        channel === "phone"
    ) {

        const remaining =
            getRemainingCooldown(
                user,
                channel
            );


        if (
            remaining > 0
        ) {

            /*
             * If an active OTP exists, tell the frontend it
             * remains available rather than generating another.
             */

            const activeOtp =
                getActiveOtp(
                    user
                );


            if (
                activeOtp &&
                normalizeChannel(
                    user["OTP CHANNEL"]
                ) === channel
            ) {

                const delivery = {

                    emailSent:
                        false,

                    smsSent:
                        false,

                    deliveryConfigured:
                        false

                };


                return buildOtpResponse(
                    user,
                    activeOtp,
                    channel,
                    delivery,
                    "Your existing verification code is still active."
                );

            }


            return {

                success: false,

                code:
                    "OTP_COOLDOWN",

                message:
                    "Please wait before requesting another verification code.",

                cooldown:
                    remaining,

                channel

            };

        }

    }


    /*
     * Generate a BRAND NEW server-side OTP.
     */

    const otp =
        generateOTP();


    let otpData;


    try {

        otpData =
            saveOtp(
                user,
                otp,
                channel
            );

    } catch (error) {

        return {

            success: false,

            code:
                "OTP_STORAGE_ERROR",

            message:
                "Unable to securely store the verification code right now.",

            detail:
                DEMO_MODE
                    ? safeString(
                        error.message
                    )
                    : ""

        };

    }


    /*
     * Delivery is attempted after storage.
     */

    const delivery =
        sendOTPByChannel(
            user,
            otp,
            channel
        );


    const delivered =
        Boolean(
            delivery.emailSent ||
            delivery.smsSent
        );


    /*
     * OTP delivery must succeed before the request is reported
     * as successful. The OTP itself is never returned to the
     * frontend.
     */
    if (
        !delivered
    ) {

        clearOtpCompletely(
            user
        );


        let deliveryMessage =
            "The verification code could not be delivered. Please try again.";


        if (
            channel === "email"
        ) {

            deliveryMessage =
                "The verification code could not be sent to Gmail. Please check the email delivery configuration and try again.";

        }


        if (
            channel === "phone"
        ) {

            deliveryMessage =
                "The verification code could not be sent by SMS. Please check the phone delivery configuration and try again.";

        }


        return {

            success: false,

            code:
                "OTP_DELIVERY_FAILED",

            message:
                deliveryMessage,

            emailSent:
                Boolean(
                    delivery.emailSent
                ),

            smsSent:
                Boolean(
                    delivery.smsSent
                ),

            emailError:
                safeString(
                    delivery.emailError
                ),

            smsError:
                safeString(
                    delivery.smsError
                ),

            channel

        };

    }


    let message =
        "Verification code request accepted.";


    if (
        channel === "email" &&
        delivery.emailSent
    ) {

        message =
            "Verification code request accepted. Check the registered Gmail address for the code.";

    }


    if (
        channel === "phone" &&
        delivery.smsSent
    ) {

        message =
            "Verification code request accepted. Check the registered phone for the code.";

    }


    if (
        channel === "both"
    ) {

        message =
            "Verification code request accepted. Check the selected verification channels for the code.";

    }


    return buildOtpResponse(
        user,
        otpData,
        channel,
        delivery,
        message
    );

}


/* =========================================================
   COMPATIBILITY OTP FUNCTIONS
   ========================================================= */

function generateOtp(
    data
) {

    return prepareOtp(
        data
    );

}


function resendOTP(
    data
) {

    data =
        data || {};


    const channel =
        resolveOtpChannel(
            data
        );


    /*
     * resendOTP obeys the exact same independent
     * channel cooldown.
     */

    return prepareOtp(
        data
    );

}


function requestOtp(
    data
) {

    return resendOTP(
        data
    );

}


/* =========================================================
   VERIFY OTP
   ========================================================= */

function verifyOTP(
    data
) {

    data =
        data || {};


    const user =
        resolveOtpIdentity(
            data
        );


    if (!user) {

        return {

            success: false,

            code:
                "ACCOUNT_NOT_FOUND",

            message:
                "Account does not exist."

        };

    }


    if (
        toBoolean(
            user["VERIFIED"]
        )
    ) {

        return {

            success: false,

            code:
                "ALREADY_VERIFIED",

            message:
                "This account is already verified."

        };

    }


    if (
        isOtpLocked(
            user
        )
    ) {

        return {

            success: false,

            code:
                "OTP_LOCKED",

            message:
                "Too many incorrect attempts. Please try again after the temporary lock expires."

        };

    }


    const submittedOtp =
        safeString(
            data.otp
        );


    if (
        !/^\d{6}$/.test(
            submittedOtp
        )
    ) {

        return {

            success: false,

            code:
                "INVALID_OTP",

            message:
                "Please enter the complete 6-digit verification code."

        };

    }


    const storedOtp =
        safeString(
            user["OTP"]
        );


    const expiresAt =
        parseDate(
            user["OTP EXPIRES"]
        );


    if (
        !storedOtp ||
        !expiresAt
    ) {

        return {

            success: false,

            code:
                "OTP_NOT_READY",

            message:
                "Your verification code is not ready yet. Please request a new code."

        };

    }


    if (
        expiresAt.getTime() <=
        now().getTime()
    ) {

        clearOtpCompletely(
            user
        );


        return {

            success: false,

            code:
                "OTP_EXPIRED",

            message:
                "This verification code has expired. Please request a new code."

        };

    }


    const attempts =
        Number(
            user["OTP ATTEMPTS"] || 0
        );


    /*
     * Compare server-stored OTP.
     */

    if (
        submittedOtp !==
        storedOtp
    ) {

        const newAttempts =
            attempts + 1;


        let lockUntil =
            null;


        if (
            newAttempts >=
            OTP_MAX_ATTEMPTS
        ) {

            lockUntil =
                addMinutes(
                    now(),
                    OTP_LOCK_MINUTES
                );

        }


        const sheet =
            getSheet();


        const row =
            Number(
                user._row
            );


        const attemptsColumn =
            HEADERS.indexOf(
                "OTP ATTEMPTS"
            ) + 1;


        const lockColumn =
            HEADERS.indexOf(
                "OTP LOCK UNTIL"
            ) + 1;


        sheet
            .getRange(
                row,
                attemptsColumn
            )
            .setValue(
                newAttempts
            );


        sheet
            .getRange(
                row,
                lockColumn
            )
            .setValue(
                lockUntil || ""
            );


        try {

            updateFirebaseOtpAttempts(
                user,
                newAttempts,
                lockUntil
            );

        } catch (error) {

            console.error(
                "Firebase OTP attempt sync failed:",
                error
            );

        }


        if (
            newAttempts >=
            OTP_MAX_ATTEMPTS
        ) {

            return {

                success: false,

                code:
                    "OTP_LOCKED",

                message:
                    "Too many incorrect attempts. Your verification is temporarily locked for 30 minutes.",

                attempts:
                    newAttempts

            };

        }


        return {

            success: false,

            code:
                "INVALID_OTP",

            message:
                "The verification code is incorrect.",

            attempts:
                newAttempts,

            remainingAttempts:
                OTP_MAX_ATTEMPTS -
                newAttempts

        };

    }


    /*
     * OTP IS CORRECT.
     *
     * Mark the account verified.
     */

    const sheet =
        getSheet();


    const row =
        Number(
            user._row
        );


    const statusColumn =
        HEADERS.indexOf(
            "ACCOUNT_S"
        ) + 1;


    const verifiedColumn =
        HEADERS.indexOf(
            "VERIFIED"
        ) + 1;


    const verifiedAtColumn =
        HEADERS.indexOf(
            "VERIFIED AT"
        ) + 1;


    sheet
        .getRange(
            row,
            statusColumn
        )
        .setValue(
            "VERIFIED"
        );


    sheet
        .getRange(
            row,
            verifiedColumn
        )
        .setValue(
            true
        );


    sheet
        .getRange(
            row,
            verifiedAtColumn
        )
        .setValue(
            now()
        );


    /*
     * Clear OTP from Sheet and Firebase.
     */

    clearOtpCompletely(
        user
    );


    /*
     * Synchronize Firebase status correctly.
     */

    try {

        syncFirebaseUserStatus(
            user,
            "VERIFIED",
            true
        );

    } catch (error) {

        console.error(
            "Firebase verified status sync failed:",
            error
        );

    }


    /*
     * Refresh the user object.
     */

    user["ACCOUNT_S"] =
        "VERIFIED";


    user["VERIFIED"] =
        true;


    user["VERIFIED AT"] =
        now();


    return {

        success: true,

        code:
            "ACCOUNT_VERIFIED",

        message:
            "Account verified successfully.",

        verified:
            true,

        accountStatus:
            "VERIFIED",

        redirect:
            "dashboard.html",

        user:
            userToResponse(
                user
            )

    };

}


/* =========================================================
   LOGIN
   ========================================================= */

function loginUser(
    data
) {

    data =
        data || {};


    const identity =
        safeString(
            data.identity ||
            data.username ||
            data.email ||
            data.gmail ||
            data.phone
        );


    const password =
        safeString(
            data.password
        );


    if (!identity) {

        return {

            success: false,

            code:
                "IDENTITY_REQUIRED",

            message:
                "Please enter your username, email, or phone number."

        };

    }


    if (!password) {

        return {

            success: false,

            code:
                "PASSWORD_REQUIRED",

            message:
                "Please enter your password."

        };

    }


    const user =
        findUser(
            identity
        );


    if (!user) {

        return {

            success: false,

            code:
                "ACCOUNT_NOT_FOUND",

            message:
                "Account does not exist."

        };

    }


    const storedPassword =
        safeString(
            user["PASSWORD"]
        );


    if (
        password !==
        storedPassword
    ) {

        return {

            success: false,

            code:
                "INVALID_CREDENTIALS",

            message:
                "Invalid username/email or password."

        };

    }


    const status =
        normalizeStatus(
            user["ACCOUNT_S"]
        );


    if (
        status === "DISABLED"
    ) {

        return {

            success: false,

            code:
                "ACCOUNT_DISABLED",

            message:
                "This account is disabled."

        };

    }


    if (
        status === "SUSPENDED"
    ) {

        return {

            success: false,

            code:
                "ACCOUNT_SUSPENDED",

            message:
                "This account is suspended."

        };

    }


    if (
        status === "BLOCKED"
    ) {

        return {

            success: false,

            code:
                "ACCOUNT_BLOCKED",

            message:
                "This account is blocked."

        };

    }


    if (
        !toBoolean(
            user["VERIFIED"]
        ) ||
        status === "PENDING"
    ) {

        return {

            success: false,

            code:
                "REQUIRES_VERIFICATION",

            message:
                "Account is not verified. Please verify your OTP.",

            verified:
                false,

            requiresVerification:
                true,

            needsVerification:
                true,

            uid:
                safeString(
                    user["UID"]
                ),

            username:
                safeString(
                    user["USERNAME"]
                ),

            gmail:
                normalizeEmail(
                    user["GMAIL"]
                ),

            email:
                normalizeEmail(
                    user["GMAIL"]
                ),

            phone:
                normalizePhone(
                    user["PHONE NO."]
                ),

            redirect:
                "verify.html"

        };

    }


    const sheet =
        getSheet();


    const row =
        Number(
            user._row
        );


    const lastLoginColumn =
        HEADERS.indexOf(
            "LAST LOGIN"
        ) + 1;


    const loginTime =
        now();


    sheet
        .getRange(
            row,
            lastLoginColumn
        )
        .setValue(
            loginTime
        );


    user["LAST LOGIN"] =
        loginTime;


    try {

        firebaseRequest(
            firebaseUserPath(
                user["UID"]
            ),
            "patch",
            {

                lastLogin:
                    loginTime.toISOString()

            }
        );

    } catch (error) {

        console.error(
            "Firebase last-login sync failed:",
            error
        );

    }


    return {

        success: true,

        code:
            "LOGIN_SUCCESS",

        message:
            "Login successful.",

        verified:
            true,

        accountStatus:
            "VERIFIED",

        redirect:
            "dashboard.html",

        user:
            userToResponse(
                user
            )

    };

}


