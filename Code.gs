 */
const EMAIL_SENDER_NAME =
    "Creator Bitos";


const EMAIL_BRAND_NAME =
    "Bitos' Phone Accessories Inventory";


const EMAIL_FOOTER =
    "— By Creator Bitos";


const FIREBASE_URL =
    "https://midtermexamproject-default-rtdb.firebaseio.com/";


/*
 * OTP security mode.
 *
 * OTP is always generated by Code.gs, stored in Sheets/Firebase,
 * and delivered through the selected provider.
 * The OTP is never returned to frontend JavaScript.
 */

const DEMO_MODE =
    false;


/* =========================================================
   OTP SETTINGS
   ========================================================= */

const OTP_LENGTH =
    6;


const OTP_EXPIRATION_MINUTES =
    10;


const OTP_MAX_ATTEMPTS =
    4;


const OTP_LOCK_MINUTES =
    30;


const OTP_RESEND_COOLDOWN_SECONDS =
    120;


/* =========================================================
   USER TABLE HEADERS
   ========================================================= */

const HEADERS = [

    "UID",
    "NAME",
    "USERNAME",
    "PASSWORD",
    "AGE",
    "ACCOUNT_S",
    "GMAIL",
    "PHONE NO.",
    "ROLE",
    "VERIFIED",
    "OTP",
