/* =========================================================
   UPDATE ACCOUNT STATUS
   ========================================================= */

function updateAccountStatus(
    data
) {

    data =
        data || {};


    const user =
        resolveOtpIdentity(
            data
        );


    if (!user) {

        return {

            success: false,

            code:
                "ACCOUNT_NOT_FOUND",

            message:
                "Account does not exist."

        };

    }


    const requestedStatus =
        normalizeStatus(
            data.status ||
            data.accountStatus
        );


    const verified =
        requestedStatus ===
        "VERIFIED";


    const sheet =
        getSheet();


    const row =
        Number(
            user._row
        );


    const statusColumn =
        HEADERS.indexOf(
            "ACCOUNT_S"
        ) + 1;


    const verifiedColumn =
        HEADERS.indexOf(
            "VERIFIED"
        ) + 1;


    sheet
        .getRange(
            row,
            statusColumn
        )
        .setValue(
            requestedStatus
        );


    sheet
        .getRange(
            row,
            verifiedColumn
        )
        .setValue(
            verified
        );


    user["ACCOUNT_S"] =
        requestedStatus;


    user["VERIFIED"] =
        verified;


    /*
     * FIXED:
     *
     * We no longer call markFirebaseUserVerified()
     * unconditionally.
     *
     * Firebase now receives the actual requested status.
     */

    try {

        syncFirebaseUserStatus(
            user,
            requestedStatus,
            verified
        );

    } catch (error) {

        console.error(
            "Firebase account-status sync failed:",
            error
        );

        return {

            success: false,

            code:
                "FIREBASE_SYNC_ERROR",

            message:
                "Account status was changed in Google Sheets, but Firebase synchronization failed."

        };

    }


    return {

        success: true,

        code:
            "ACCOUNT_STATUS_UPDATED",

        message:
            "Account status updated successfully.",

        accountStatus:
            requestedStatus,

        verified,

        user:
            userToResponse(
                user
            )

    };

}


/* =========================================================
   PASSWORD RECOVERY
   ========================================================= */

function forgotPassword(
    data
) {

    data =
        data || {};


    const user =
        resolveOtpIdentity(
            data
        );


    /*
     * For this school-project requirement we explicitly
     * report missing accounts.
     */

    if (!user) {

        return {

            success: false,

            code:
                "ACCOUNT_NOT_FOUND",

            message:
                "Account does not exist."

        };

    }


    const status =
        normalizeStatus(
            user["ACCOUNT_S"]
        );


    if (
        status === "DISABLED"
    ) {

        return {

            success: false,

            code:
                "ACCOUNT_DISABLED",

            message:
                "This account is disabled."

        };

    }


    if (
        status === "SUSPENDED"
    ) {

        return {

            success: false,

            code:
                "ACCOUNT_SUSPENDED",

            message:
                "This account is suspended."

        };

    }


    if (
        status === "BLOCKED"
    ) {

        return {

            success: false,

            code:
                "ACCOUNT_BLOCKED",

            message:
                "This account is blocked."

        };

    }


    /*
     * Password recovery should only be available for
     * an existing verified account.
     */

    if (
        !toBoolean(
            user["VERIFIED"]
        )
    ) {

        return {

            success: false,

            code:
                "RECOVERY_NOT_ALLOWED",

            message:
                "This account has not completed verification yet."

        };

    }


    const channel =
        normalizeChannel(
            data.channel ||
            "email"
        );


    /*
     * Use the same server OTP engine.
     */

    const response =
        prepareOtp({

            identity:
                data.identity,

            uid:
                user["UID"],

            username:
                user["USERNAME"],

            email:
                user["GMAIL"],

            gmail:
                user["GMAIL"],

            phone:
                user["PHONE NO."],

            channel,

            purpose:
                "recovery"

        });


    if (
        !response.success
    ) {

        return response;

    }


    /*
     * Change the public message to make the purpose clear.
     */

    response.code =
        "RECOVERY_OTP_READY";


    response.message =
        response.emailSent ||
        response.smsSent
            ? "Password recovery code request accepted. Check your registered verification channel for the code."
            : "Password recovery code could not be delivered.";


    return response;

}


/* =========================================================
   RECOVERY TOKEN
   ========================================================= */

function recoveryTokenKey(
    uid
) {

    return (
        "SF_RECOVERY_" +
        safeString(
            uid
        )
    );

}


function createRecoveryToken(
    user
) {

    const uid =
        safeString(
            user["UID"]
        );


    if (!uid) {

        throw new Error(
            "Missing UID for recovery token."
        );

    }


    const token =
        Utilities.getUuid() +
        "-" +
        Utilities.getUuid();


    const expiresAt =
        addMinutes(
            now(),
            10
        );


    const record = {

        token,

        uid,

        expiresAt:
            expiresAt.toISOString()

    };


    PropertiesService
        .getScriptProperties()
        .setProperty(
            recoveryTokenKey(
                uid
            ),
            JSON.stringify(
                record
            )
        );


    return {

        token,

        expiresAt

    };

}


function getRecoveryTokenRecord(
    uid
) {

    const value =
        PropertiesService
            .getScriptProperties()
            .getProperty(
                recoveryTokenKey(
                    uid
                )
            );


    if (!value) {
        return null;
    }


    try {

        return JSON.parse(
            value
        );

    } catch (error) {

        return null;

    }

}


function clearRecoveryToken(
    uid
) {

    PropertiesService
        .getScriptProperties()
        .deleteProperty(
            recoveryTokenKey(
                uid
            )
        );

}


/* =========================================================
   VERIFY RECOVERY OTP
   ========================================================= */

function verifyRecoveryOtp(
    data
) {

    data =
        data || {};


    const user =
        resolveOtpIdentity(
            data
        );


    if (!user) {

        return {

            success: false,

            code:
                "ACCOUNT_NOT_FOUND",

            message:
                "Account does not exist."

        };

    }


    if (
        !toBoolean(
            user["VERIFIED"]
        )
    ) {

        return {

            success: false,

            code:
                "RECOVERY_NOT_ALLOWED",

            message:
                "This account has not completed verification yet."

        };

    }


    const otp =
        safeString(
            data.otp
        );


    if (
        !/^\d{6}$/.test(
            otp
        )
    ) {

        return {

            success: false,

            code:
                "INVALID_OTP",

            message:
                "Please enter the complete 6-digit recovery code."

        };

    }


    if (
        isOtpLocked(
            user
        )
    ) {

        return {

            success: false,

            code:
                "OTP_LOCKED",

            message:
                "Too many incorrect attempts. Please try again after the temporary lock expires."

        };

    }


    const storedOtp =
        safeString(
            user["OTP"]
        );


    const expiresAt =
        parseDate(
            user["OTP EXPIRES"]
        );


    if (
        !storedOtp ||
        !expiresAt
    ) {

        return {

            success: false,

            code:
                "OTP_NOT_READY",

            message:
                "Your recovery code is not ready yet. Please request a new code."

        };

    }


    if (
        expiresAt.getTime() <=
        now().getTime()
    ) {

        clearOtpCompletely(
            user
        );


        return {

            success: false,

            code:
                "OTP_EXPIRED",

            message:
                "This recovery code has expired. Please request a new code."

        };

    }


    const attempts =
        Number(
            user["OTP ATTEMPTS"] || 0
        );


    if (
        otp !==
        storedOtp
    ) {

        const newAttempts =
            attempts + 1;


        let lockUntil =
            null;


        if (
            newAttempts >=
            OTP_MAX_ATTEMPTS
        ) {

            lockUntil =
                addMinutes(
                    now(),
                    OTP_LOCK_MINUTES
                );

        }


        const sheet =
            getSheet();


        const row =
            Number(
                user._row
            );


        const attemptsColumn =
            HEADERS.indexOf(
                "OTP ATTEMPTS"
            ) + 1;


        const lockColumn =
            HEADERS.indexOf(
                "OTP LOCK UNTIL"
            ) + 1;


        sheet
            .getRange(
                row,
                attemptsColumn
            )
            .setValue(
                newAttempts
            );


        sheet
            .getRange(
                row,
                lockColumn
            )
            .setValue(
                lockUntil || ""
            );


        try {

            updateFirebaseOtpAttempts(
                user,
                newAttempts,
                lockUntil
            );

        } catch (error) {

            console.error(
                "Firebase recovery attempt sync failed:",
                error
            );

        }


        if (
            newAttempts >=
            OTP_MAX_ATTEMPTS
        ) {

            return {

                success: false,

                code:
                    "OTP_LOCKED",

                message:
                    "Too many incorrect attempts. Password recovery is temporarily locked for 30 minutes."

            };

        }


        return {

            success: false,

            code:
                "INVALID_OTP",

            message:
                "The recovery code is incorrect.",

            attempts:
                newAttempts,

            remainingAttempts:
                OTP_MAX_ATTEMPTS -
                newAttempts

        };

    }


    /*
     * Correct recovery OTP.
     *
     * DO NOT mark the account as verified.
     */

    let recovery;


    try {

        recovery =
            createRecoveryToken(
                user
            );

    } catch (error) {

        return {

            success: false,

            code:
                "RECOVERY_TOKEN_ERROR",

            message:
                "Unable to create a secure password-recovery session."

        };

    }


    /*
     * OTP has now been consumed.
     */

    clearOtpCompletely(
        user
    );


    return {

        success: true,

        code:
            "RECOVERY_VERIFIED",

        message:
            "Recovery code verified successfully. You may now create a new password.",

        recoveryToken:
            recovery.token,

        recoveryTokenExpiresAt:
            recovery.expiresAt
                .toISOString(),

        uid:
            safeString(
                user["UID"]
            ),

        username:
            safeString(
                user["USERNAME"]
            ),

        gmail:
            normalizeEmail(
                user["GMAIL"]
            ),

        email:
            normalizeEmail(
                user["GMAIL"]
            ),

        phone:
            normalizePhone(
                user["PHONE NO."]
            ),

        verified:
            true

    };

}


/* =========================================================
   RESET PASSWORD
   ========================================================= */

function resetPassword(
    data
) {

    data =
        data || {};


    const recoveryToken =
        safeString(
            data.recoveryToken ||
            data.token
        );


    if (!recoveryToken) {

        return {

            success: false,

            code:
                "RECOVERY_TOKEN_INVALID",

            message:
                "Your recovery session is invalid. Please verify the recovery code again."

        };

    }


    const uid =
        safeString(
            data.uid
        );


    if (!uid) {

        return {

            success: false,

            code:
                "RECOVERY_TOKEN_INVALID",

            message:
                "Your recovery session is invalid."

        };

    }


    const record =
        getRecoveryTokenRecord(
            uid
        );


    if (!record) {

        return {

            success: false,

            code:
                "RECOVERY_TOKEN_INVALID",

            message:
                "Your recovery session is invalid or has already been used."

        };

    }


    if (
        safeString(
            record.token
        ) !==
        recoveryToken
    ) {

        return {

            success: false,

            code:
                "RECOVERY_TOKEN_INVALID",

            message:
                "Your recovery session is invalid."

        };

    }


    const tokenExpiresAt =
        parseDate(
            record.expiresAt
        );


    if (
        !tokenExpiresAt ||
        tokenExpiresAt.getTime() <=
        now().getTime()
    ) {

        clearRecoveryToken(
            uid
        );


        return {

            success: false,

            code:
                "RECOVERY_EXPIRED",

            message:
                "Your password recovery session has expired. Please start again."

        };

    }


    const user =
        findUserByUid(
            uid
        );


    if (!user) {

        clearRecoveryToken(
            uid
        );


        return {

            success: false,

            code:
                "ACCOUNT_NOT_FOUND",

            message:
                "Account does not exist."

        };

    }


    const password =
        safeString(
            data.newPassword ||
            data.password
        );


    const confirmPassword =
        safeString(
            data.confirmPassword
        );


    if (
        password.length < 8
    ) {

        return {

            success: false,

            code:
                "PASSWORD_INVALID",

            message:
                "Password must be at least 8 characters."

        };

    }


    if (
        !/[A-Z]/.test(
            password
        ) ||
        !/[a-z]/.test(
            password
        ) ||
        !/\d/.test(
            password
        ) ||
        !/[^A-Za-z0-9]/.test(
            password
        )
    ) {

        return {

            success: false,

            code:
                "PASSWORD_INVALID",

            message:
                "Password must include uppercase, lowercase, number, and special character."

        };

    }


    if (
        password !==
        confirmPassword
    ) {

        return {

            success: false,

            code:
                "PASSWORD_MISMATCH",

            message:
                "Passwords do not match."

        };

    }


    /*
     * Update password in the existing USER sheet.
     */

    const sheet =
        getSheet();


    const row =
        Number(
            user._row
        );


    const passwordColumn =
        HEADERS.indexOf(
            "PASSWORD"
        ) + 1;


    sheet
        .getRange(
            row,
            passwordColumn
        )
        .setValue(
            password
        );


    /*
     * Password reset is complete.
     */

    clearRecoveryToken(
        uid
    );


    /*
     * Any old OTP state is removed.
     */

    clearOtpCompletely(
        user
    );


    /*
     * Firebase does NOT receive the plaintext password.
     *
     * We only synchronize the fact that the account remains
     * verified and the password was changed.
     */

    try {

        firebaseRequest(
            firebaseUserPath(
                uid
            ),
            "patch",
            {

                passwordUpdatedAt:
                    now().toISOString(),

                verified:
                    true,

                accountStatus:
                    "VERIFIED"

            }
        );

    } catch (error) {

        console.error(
            "Firebase password metadata sync failed:",
            error
        );

    }


    return {

        success: true,

        code:
            "PASSWORD_RESET_SUCCESS",

        message:
            "Your password has been reset successfully. You can now sign in with your new password.",

        uid,

        verified:
            true,

        accountStatus:
            "VERIFIED",

        redirect:
            "auth.html#login"

    };

}


/* =========================================================
   EMPLOYEE REGISTRATION
   ========================================================= */

function registerUser(
    data
) {

    data =
        data || {};


    const validation =
        validateRegistrationData(
            data
        );


    if (
        !validation.valid
    ) {

        return {

            success: false,

            code:
                validation.code,

            message:
                validation.message

        };

    }


    const registration =
        validation.data;


    const duplicate =
        findDuplicateUser(
            registration.username,
            registration.gmail,
            registration.phone
        );


    if (duplicate) {

        let message =
            "An account with these details already exists.";


        if (
            duplicate.code ===
            "USERNAME_EXISTS"
        ) {

            message =
                "Username already exists.";

        }


        if (
            duplicate.code ===
            "EMAIL_EXISTS"
        ) {

            message =
                "This Gmail address is already registered.";

        }


        if (
            duplicate.code ===
            "PHONE_EXISTS"
        ) {

            message =
                "This phone number is already registered.";

        }


        return {

            success: false,

            code:
                duplicate.code,

            message

        };

    }


    const uid =
        generateUID();


    const createdAt =
        now();


    const sheet =
        getSheet();


    const rowValues = [

        uid,

        registration.name,

        registration.username,

        registration.password,

        registration.age,

        "PENDING",

        registration.gmail,

        registration.phone,

        "Employee",

        false,

        "",

        "",

        0,

        "",

        "",

        createdAt,

        "",

        "",

        "",

        "",

        ""

    ];


    sheet.appendRow(
        rowValues
    );


    const newRow =
        sheet.getLastRow();


    const user = {};


    HEADERS.forEach(
        (
            header,
            index
        ) => {

            user[header] =
                rowValues[index];

        }
    );


    user._row =
        newRow;


    /*
     * Save account to Firebase.
     */

    try {

        saveFirebaseUser(
            user
        );

    } catch (error) {

        /*
         * Roll the registration back if Firebase creation
         * fails, keeping Sheets and Firebase synchronized.
         */

        sheet.deleteRow(
            newRow
        );


        return {

            success: false,

            code:
                "FIREBASE_REGISTRATION_ERROR",

            message:
                "The account could not be synchronized with the database. Please try again."

        };

    }


    /*
     * Automatically issue the initial EMAIL verification code.
     * The code is generated and stored server-side and sent by
     * Gmail. It is never returned to the frontend.
     */
    const otpResponse =
        prepareOtp({

            uid:
                uid,

            channel:
                "email",

            purpose:
                "registration"

        });


    const otpReady =
        Boolean(
            otpResponse &&
            otpResponse.success
        );


    const emailSent =
        Boolean(
            otpResponse &&
            otpResponse.emailSent
        );


    const registrationMessage =
        otpReady && emailSent
            ? "Account created successfully. A verification code was requested for your Gmail address."
            : "Account created successfully, but the verification code could not be delivered. Open the verification page and use Send code to try again.";



    return {

        success: true,

        code:
            "REGISTRATION_SUCCESS",

        message:
            registrationMessage,

        uid,

        username:
            registration.username,

        name:
            registration.name,

        gmail:
            registration.gmail,

        email:
            registration.gmail,

        phone:
            registration.phone,

        role:
            "Employee",

        verified:
            false,

        accountStatus:
            "PENDING",

        otpReady:
            otpReady,

        emailSent:
            emailSent,

        otpExpiresAt:
            otpReady &&
            otpResponse.expiresAt
                ? otpResponse.expiresAt
                : "",

        otpCooldownSeconds:
            otpReady
                ? Number(
                    otpResponse.cooldown ||
                    OTP_RESEND_COOLDOWN_SECONDS
                )
                : 0,

        redirect:
            "verify.html"

    };

}


/* =========================================================
   ADMIN REGISTRATION
   ========================================================= */

function registerAdmin(
    data
) {

    data =
        data || {};


    const validation =
        validateRegistrationData(
            data
        );


    if (
        !validation.valid
    ) {

        return {

            success: false,

            code:
                validation.code,

            message:
                validation.message

        };

    }


    const registration =
        validation.data;


    const duplicate =
        findDuplicateUser(
            registration.username,
            registration.gmail,
            registration.phone
        );


    if (duplicate) {

        let message =
            "An account with these details already exists.";


        if (
            duplicate.code ===
            "USERNAME_EXISTS"
        ) {

            message =
                "Username already exists.";

        }


        if (
            duplicate.code ===
            "EMAIL_EXISTS"
        ) {

            message =
                "This Gmail address is already registered.";

        }


        if (
            duplicate.code ===
            "PHONE_EXISTS"
        ) {

            message =
                "This phone number is already registered.";

        }


        return {

            success: false,

            code:
                duplicate.code,

            message

        };

    }


    /*
     * Admin registration is kept as a separate backend
     * operation so a normal Employee registration can never
     * silently become an Admin.
     */

    const uid =
        generateUID();


    const createdAt =
        now();


    const sheet =
        getSheet();


    const rowValues = [

        uid,

        registration.name,

        registration.username,

        registration.password,

        registration.age,

        "PENDING",

        registration.gmail,

        registration.phone,

        "Admin",

        false,

        "",

        "",

        0,

        "",

        "",

        createdAt,

        "",

        "",

        "",

        "",

        ""

    ];


    sheet.appendRow(
        rowValues
    );


    const newRow =
        sheet.getLastRow();


    const user = {};


    HEADERS.forEach(
        (
            header,
            index
        ) => {

            user[header] =
                rowValues[index];

        }
    );


    user._row =
        newRow;


    try {

        saveFirebaseUser(
            user
        );

    } catch (error) {

        sheet.deleteRow(
            newRow
        );


        return {

            success: false,

            code:
                "FIREBASE_REGISTRATION_ERROR",

            message:
                "The admin account could not be synchronized with the database. Please try again."

        };

    }


    /*
     * Automatically issue the initial EMAIL verification code.
     * The code is generated and stored server-side and sent by
     * Gmail. It is never returned to the frontend.
     */
    const otpResponse =
        prepareOtp({

            uid:
                uid,

            channel:
                "email",

            purpose:
                "registration"

        });


    const otpReady =
        Boolean(
            otpResponse &&
            otpResponse.success
        );


    const emailSent =
        Boolean(
            otpResponse &&
            otpResponse.emailSent
        );


    const registrationMessage =
        otpReady && emailSent
            ? "Admin account created successfully. A verification code was requested for the Gmail address."
            : "Admin account created successfully, but the verification code could not be delivered. Open the verification page and use Send code to try again.";


    return {

        success: true,

        code:
            "ADMIN_REGISTRATION_SUCCESS",

        message:
            registrationMessage,

        uid,

        username:
            registration.username,

        name:
            registration.name,

        gmail:
            registration.gmail,

        email:
            registration.gmail,

        phone:
            registration.phone,

        role:
            "Admin",

        verified:
            false,

        accountStatus:
            "PENDING",

        otpReady:
            otpReady,

        emailSent:
            emailSent,

        otpExpiresAt:
            otpReady &&
            otpResponse.expiresAt
                ? otpResponse.expiresAt
                : "",

        otpCooldownSeconds:
            otpReady
                ? Number(
                    otpResponse.cooldown ||
                    OTP_RESEND_COOLDOWN_SECONDS
                )
                : 0,

        redirect:
            "verify.html"

    };

}


/* =========================================================
   API REQUEST ROUTER
   ========================================================= */

function parseRequestBody(
    e
) {

    if (
        !e ||
        !e.postData ||
        !e.postData.contents
    ) {

        return {};

    }


    const raw =
        safeString(
            e.postData.contents
        );


    if (!raw) {
        return {};
    }


    try {

        return JSON.parse(
            raw
        );

    } catch (error) {

        return {};

    }

}


/* =========================================================
   DO POST
   ========================================================= */

function doPost(
    e
) {

    try {

        const data =
            parseRequestBody(
                e
            );


        const action =
            safeString(
                data.action ||
                data.operation ||
                data.request
            ).toLowerCase();


        let result;


        switch (action) {


            /* ---------------------------------------------
               REGISTRATION
            --------------------------------------------- */

            case "register":

                result =
                    registerUser(
                        data
                    );

                break;


            case "registeruser":

                result =
                    registerUser(
                        data
                    );

                break;


            case "registeradmin":

                result =
                    registerAdmin(
                        data
                    );

                break;


            /* ---------------------------------------------
               LOGIN
            --------------------------------------------- */

            case "login":

                result =
                    loginUser(
                        data
                    );

                break;


            case "loginuser":

                result =
                    loginUser(
                        data
                    );

                break;


            /* ---------------------------------------------
               OTP
            --------------------------------------------- */

            case "prepareotp":

                result =
                    prepareOtp(
                        data
                    );

                break;


            case "generateotp":

                result =
                    generateOtp(
                        data
                    );

                break;


            case "resendotp":

                result =
                    resendOTP(
                        data
                    );

                break;


            case "requestotp":

                result =
                    requestOtp(
                        data
                    );

                break;


            case "verifyotp":

                result =
                    verifyOTP(
                        data
                    );

                break;


            /* ---------------------------------------------
               USER
            --------------------------------------------- */

            case "getuser":

                result =
                    getUser(
                        data
                    );

                break;


            /* ---------------------------------------------
               ACCOUNT STATUS
            --------------------------------------------- */

            case "updatestatus":

                result =
                    updateAccountStatus(
                        data
                    );

                break;


            case "updateaccountstatus":

                result =
                    updateAccountStatus(
                        data
                    );

                break;


            /* ---------------------------------------------
               PASSWORD RECOVERY
            --------------------------------------------- */

            case "forgotpassword":

                result =
                    forgotPassword(
                        data
                    );

                break;


            case "verifyrecoveryotp":

                result =
                    verifyRecoveryOtp(
                        data
                    );

                break;


            case "resetpassword":

                result =
                    resetPassword(
                        data
                    );

                break;


            /* ---------------------------------------------
               UNKNOWN ACTION
            --------------------------------------------- */

            default:

                result = {

                    success: false,

                    code:
                        "UNKNOWN_ACTION",

                    message:
                        "Unknown API action."

                };

                break;

        }


        return jsonResponse(
            result
        );

    } catch (error) {

        console.error(
            "STOCKFLOW doPost error:",
            error
        );


        return jsonResponse({

            success: false,

            code:
                "SERVER_ERROR",

            message:
                "The server encountered an unexpected error.",

            detail:
                DEMO_MODE
                    ? safeString(
                        error.message
                    )
                    : ""

        });

    }

}


